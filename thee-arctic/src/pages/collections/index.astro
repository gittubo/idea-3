---
import Base from '../../layouts/Base.astro';
import { collections, inCollection } from '../../data/catalog';
---
<Base title="Collections">
  <section class="wrap page-hero">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Collections</span></nav>
    <h1 class="display">Collections</h1>
  </section>
  <section class="wrap colls">
    {collections.map((c) => (
      <a class="coll reveal" href={`/collections/${c.slug}`}>
        <img src={c.cover} alt="" loading="lazy" />
        <div><strong>{c.name}</strong><span>{c.blurb} · {inCollection(c.slug).length} styles</span></div>
      </a>
    ))}
  </section>
</Base>
<style>
  .colls { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .coll { position: relative; border-radius: 22px; overflow: hidden; aspect-ratio: 4/5; display: flex; align-items: flex-end; padding: 26px; color: #fff; background: var(--stone-1); }
  .coll img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .coll::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,.55)); }
  .coll:hover img { transform: scale(1.03); }
  .coll div { position: relative; z-index: 1; }
  strong { display: block; font-family: var(--display); font-weight: 560; letter-spacing: -0.03em;  font-size: clamp(26px, 3.4vw, 46px); line-height: 1; }
  .coll span { font-size: 14px; opacity: .9; }
  @media (max-width: 760px) { .colls { grid-template-columns: 1fr; } }
</style>
