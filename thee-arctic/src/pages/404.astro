---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap" style="padding-block:clamp(80px,14vw,200px);text-align:center;display:grid;gap:18px;justify-items:center">
    <p class="eyebrow">Error 404</p>
    <h1 class="display" style="font-size:clamp(56px,11vw,170px);margin:0">This page<br /><span class="serif">doesn't exist.</span></h1>
    <p style="color:var(--muted)">It may have moved, or the link may be wrong.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
      <a class="btn" href="/">Back home</a>
      <button class="btn ghost" type="button" data-open="search">Search</button>
    </div>
  </section>
</Base>
