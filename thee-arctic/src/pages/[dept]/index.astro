---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import { departments, inDept } from '../../data/catalog';
import { looks, lookItems } from '../../data/looks';

export function getStaticPaths() {
  return departments.map((d) => ({ params: { dept: d.slug }, props: { dept: d } }));
}
const { dept } = Astro.props;
const items = inDept(dept.slug);
const deptLooks = looks.filter((l) => l.dept === dept.slug);
---
<Base title={dept.title} description={`${dept.title}: ${dept.blurb}`}>
  <section class="dept-hero" style={`--tint:${dept.tint}`}>
    <div class="wrap dh-inner">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>{dept.name}</span></nav>
        <h1 class="display">{dept.title.replace('THEE ARCTIC ', 'THEE ARCTIC\n')}</h1>
        <p>{dept.tagline} {dept.blurb}</p>
      </div>
      <div class="cat-tiles">
        {dept.categories.slice(0, 6).map((c) => (
          <a class="tile" href={`/${dept.slug}/${c.slug}`}><span>{c.name}</span><span aria-hidden="true">→</span></a>
        ))}
      </div>
    </div>
  </section>
  {deptLooks.length > 0 && (
    <section class="wrap dept-looks">
      <div class="section-head"><div><p class="eyebrow">{dept.title}</p><h2 class="h2">Shop the look</h2></div><a class="link-arrow" href="/lookbook">Lookbook</a></div>
      <div class="rail dl-rail">
        {deptLooks.map((l) => (
          <a class="dl-tile" href={`/lookbook#${l.id}`}>
            <img src={l.image} alt={`${dept.title} look`} loading="lazy" />
            {lookItems(l).length > 0 && <span>{lookItems(l).length} piece{lookItems(l).length > 1 ? 's' : ''}</span>}
          </a>
        ))}
      </div>
    </section>
  )}
  <Listing
    products={items}
    links={[{ label: `All ${dept.name}`, href: `/${dept.slug}`, on: true }, ...dept.categories.map((c) => ({ label: c.name, href: `/${dept.slug}/${c.slug}` }))]}
  />
</Base>

<style>
  .dept-hero { background: linear-gradient(180deg, var(--tint), #fff); margin-bottom: 18px; }
  .dh-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end; padding-block: 8px 36px; }
  h1 { white-space: pre-line; font-size: clamp(44px, 7.4vw, 116px); margin: 10px 0 14px; }
  .dh-inner p { color: var(--ink-2); max-width: 46ch; margin: 0; }
  .cat-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .tile { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 16px; min-height: 84px; display: flex; justify-content: space-between; align-items: flex-end; gap: 8px; font-size: 14px; font-weight: 600; transition: background .3s, color .3s; }
  .tile:hover { background: var(--ink); color: #fff; }
  .dept-looks { margin-bottom: clamp(32px, 5vw, 56px); }
  .dl-rail { grid-auto-columns: calc((100% - 16px * 3) / 3.5); }
  @media (max-width: 900px) { .dl-rail { grid-auto-columns: 72%; } }
  .dl-tile { position: relative; display: block; aspect-ratio: 4/5; border-radius: 18px; overflow: hidden; background: var(--stone-1); }
  .dl-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .dl-tile:hover img { transform: scale(1.03); }
  .dl-tile span { position: absolute; left: 12px; bottom: 12px; background: #fff; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  @media (max-width: 900px) { .dh-inner { grid-template-columns: 1fr; } .cat-tiles { grid-template-columns: repeat(3, 1fr); } }
</style>
