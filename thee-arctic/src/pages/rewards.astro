---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const tiers = [
  { name: 'Member', pts: '0 – 499 pts', perks: ['1 point per $1', 'Birthday gift', 'Members-only sales'] },
  { name: 'Insider', pts: '500 – 1,499 pts', perks: ['1.25 points per $1', 'Free standard shipping', 'Early drop access'] },
  { name: 'Icon', pts: '1,500+ pts', perks: ['1.5 points per $1', 'Free express shipping', 'Members-only drops', 'Priority support'] },
];
---
<Base title="Arctic Rewards" description="Arctic Rewards is coming soon: earn points on every order and unlock perks.">
  <section class="rw-hero grain">
    <div class="wrap">
      <p class="eyebrow" style="color:var(--on-dark-muted)">Arctic Rewards <span class="soon on-dark">Coming soon</span></p>
      <h1 class="display">Shop. Earn.<br /><span class="serif">Repeat.</span></h1>
      <p>Arctic Rewards is coming soon: points on every order that turn into money off. Create a free account now and you'll be ready when it launches.</p>
      <a class="btn light" href="/account">Create an account</a>
    </div>
  </section>
  <section class="section wrap">
    <h2 class="h2" style="margin-bottom:24px">How it will work</h2>
    <div class="steps">
      <div><Icon name="user" /><strong>Join</strong><p>Create a free account today. A 15% welcome offer on your first order is coming soon.</p></div>
      <div><Icon name="bag" /><strong>Earn</strong><p>Get points for every dollar, reviews, referrals and your birthday. Coming soon.</p></div>
      <div><Icon name="gift" /><strong>Redeem</strong><p>100 points = $5 off at checkout. Coming soon.</p></div>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0">
    <h2 class="h2" style="margin-bottom:24px">Tiers <span class="soon">Coming soon</span></h2>
    <div class="tiers">
      {tiers.map((t, k) => (
        <div class={`tier t${k}`}>
          <strong>{t.name}</strong><span>{t.pts}</span>
          <ul>{t.perks.map((x) => <li><Icon name="check" /> {x}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .rw-hero { background: radial-gradient(120% 100% at 80% 0%, #3b3731, var(--deep) 58%, #12100e); color: #fff; padding-block: clamp(60px, 9vw, 130px); }
  .rw-hero h1 { font-size: clamp(56px, 10vw, 150px); margin: 10px 0 18px; }
  .rw-hero p { max-width: 40ch; opacity: .85; margin: 0 0 24px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .steps div { background: var(--stone-1); border-radius: 18px; padding: 24px; display: grid; gap: 8px; }
  .steps :global(svg) { width: 28px; height: 28px; }
  .steps strong { font-family: var(--display); font-size: 22px;  }
  .steps p { margin: 0; color: var(--muted); }
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .tier { border-radius: 20px; padding: 28px; display: grid; gap: 4px; align-content: start; }
  .tier strong { font-family: var(--display); font-weight: 560; letter-spacing: -0.03em; font-size: 34px;  }
  .tier span { font-size: 13px; opacity: .75; }
  .tier ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 8px; font-size: 14px; }
  .tier li { display: flex; gap: 8px; align-items: center; }
  .tier :global(svg) { width: 18px; height: 18px; }
  .t0 { background: var(--stone-2); }
  .t1 { background: linear-gradient(160deg, #8a8278, #4d4740); color: #fff; }
  .t2 { background: linear-gradient(160deg, var(--deep-2), #12100e); color: #fff; }
  @media (max-width: 800px) { .steps, .tiers { grid-template-columns: 1fr; } }
</style>
