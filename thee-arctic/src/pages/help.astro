---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
// Policy answers are placeholders until the real shipping and returns policies are written.
const SOON = 'Coming soon. We\'re finalising this policy and will publish it here before checkout opens.';
const faqs = [
  ['How long does shipping take?', SOON],
  ['How much is shipping?', SOON],
  ['What is your return policy?', SOON],
  ['How do I exchange a size?', SOON],
  ['Can I change or cancel my order?', SOON],
  ['Do you ship internationally?', SOON],
  ['How do I use a promo code?', SOON],
  ['Have a question that isn\'t answered here?', 'Send us a message using the contact form below and we\'ll reply by email.'],
];
---
<Base title="Help Centre">
  <section class="wrap page-hero">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Help</span></nav>
    <h1 class="display">How can we help?</h1>
  </section>
  <section class="wrap quick-help">
    <a href="#orders"><Icon name="truck" /><strong>Track my order</strong></a>
    <a href="#returns"><Icon name="return" /><strong>Start a return</strong></a>
    <a href="#sizing"><Icon name="ruler" /><strong>Size guide</strong></a>
    <a href="#contact"><Icon name="chat" /><strong>Contact us</strong></a>
  </section>
  <div class="wrap help">
    <section id="orders">
      <h2 class="h2">Track my order <span class="soon">Coming soon</span></h2>
      <p class="note">Online order tracking is coming soon, along with checkout.</p>
    </section>
    <section id="shipping"><h2 class="h2">Shipping <span class="soon">Coming soon</span></h2><p class="note">Shipping rates and delivery times will be published here before checkout opens.</p></section>
    <section id="returns"><h2 class="h2">Returns &amp; exchanges <span class="soon">Coming soon</span></h2><p class="note">Our returns and exchanges policy will be published here before checkout opens.</p></section>
    <section id="sizing">
      <h2 class="h2">Size guide</h2>
      <p>Body measurements in inches. Between sizes? Size up for a relaxed fit.</p>
      <button class="btn ghost" type="button" data-open="sizeguide">Open size chart</button>
    </section>
    <section id="faq">
      <h2 class="h2">FAQ</h2>
      {faqs.map(([q, a]) => <details class="faq"><summary>{q}</summary><p>{a}</p></details>)}
    </section>
    <section id="contact">
      <h2 class="h2">Contact us</h2>
      <p>Send us a message and we'll reply by email.</p>
      <form class="contact" data-contact novalidate>
        <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" required maxlength="100" /></div>
        <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
        <div class="field"><label for="c-topic">Topic</label>
          <select id="c-topic" name="topic">
            <option>General question</option>
            <option>Sizing and fit</option>
            <option>Order or delivery</option>
            <option>Returns and exchanges</option>
            <option>Wholesale or press</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field"><label for="c-order">Order number <span class="opt">(optional)</span></label><input id="c-order" name="order" maxlength="40" /></div>
        <div class="field" style="grid-column:1/-1"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required maxlength="5000" rows="5"></textarea></div>
        <button class="btn" type="submit">Send message</button>
        <p class="note" data-contact-msg role="status" aria-live="polite" hidden></p>
      </form>
    </section>
    <section id="privacy"><h2 class="h2">Privacy <span class="soon">Coming soon</span></h2><p class="note">Our privacy policy will be published here soon.</p></section>
    <section id="terms"><h2 class="h2">Terms <span class="soon">Coming soon</span></h2><p class="note">Our terms of service will be published here soon.</p></section>
  </div>
</Base>
<script>
  import { SUPABASE_URL, SUPABASE_KEY } from '../data/backend';

  // Messages are saved to the Supabase "messages" table (see the README). Visitors can send but never read them.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const note = form?.querySelector<HTMLParagraphElement>('[data-contact-msg]');
  const say = (t: string, ok = false) => { if (!note) return; note.textContent = t; note.classList.toggle('ok', ok); note.hidden = false; };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const get = (k: string) => String(fd.get(k) ?? '').trim();
    const body = { name: get('name'), email: get('email'), topic: get('topic'), order_number: get('order') || null, message: get('message') };
    if (!body.name) return say('Please enter your name.');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(body.email)) return say('Please enter a valid email address.');
    if (!body.message) return say('Please write a message.');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true; btn.textContent = 'Sending…';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/messages`, {
        method: 'POST',
        headers: { apikey: SUPABASE_KEY, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      say(`Thanks, ${body.name.split(' ')[0]}. Your message has been sent and we'll reply to ${body.email}.`, true);
    } catch {
      say('Your message couldn’t be sent. Please check your connection and try again.');
    } finally {
      btn.disabled = false; btn.textContent = 'Send message';
    }
  });
</script>
<style>
  .quick-help { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 32px; }
  .quick-help a { background: var(--stone-1); border-radius: 16px; padding: 22px; display: grid; gap: 10px; transition: background .2s; }
  .quick-help a:hover { background: var(--stone-2); }
  .quick-help :global(svg) { width: 26px; height: 26px; }
  .help { max-width: 860px; display: grid; gap: 48px; padding-bottom: 40px; }
  .help section { scroll-margin-top: calc(var(--header-h) + var(--catbar-h) + 20px); }
  .help .h2 { font-size: 26px; margin-bottom: 12px; }
  .help p { color: var(--ink-2); }
  .track, .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: end; }
  .track .btn, .contact .btn { justify-self: start; }
  .note.ok { border-left-color: #2e7d32; }
  .opt { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--muted); }
  .contact select { width: 100%; }
  .note { font-size: 13px; background: var(--stone-2); border-left: 3px solid var(--accent); padding: 10px 12px; border-radius: 10px; }
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; }
  .faq[open] summary::after { content: '–'; }
  .faq p { margin: 0 0 16px; }
  @media (max-width: 760px) { .quick-help { grid-template-columns: 1fr 1fr; } .track, .contact { grid-template-columns: 1fr; } }
</style>
