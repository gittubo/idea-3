---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const faqs = [
  ['How long does shipping take?', 'Standard shipping takes 3–7 business days in the US. Express takes 1–3 business days. International orders take 7–14 business days.'],
  ['How much is shipping?', 'Standard shipping is free on orders over $75, otherwise $7.95. Express shipping is $14.95.'],
  ['What is your return policy?', 'Return unworn, unwashed items with tags within 30 days for a full refund or exchange. Final-sale items and beauty products that have been opened cannot be returned.'],
  ['How do I exchange a size?', 'Start a return from your account and choose “Exchange”. We ship the new size as soon as your return is scanned.'],
  ['Can I change or cancel my order?', 'We process orders fast. Contact us within 1 hour of placing your order and we will do our best to help.'],
  ['Do you ship internationally?', 'Yes, we ship to over 100 countries. Duties and taxes are calculated at checkout.'],
  ['How do I use a promo code?', 'Enter your code at checkout. Only one promo code can be used per order.'],
];
---
<Base title="Help Centre">
  <section class="wrap page-hero">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Help</span></nav>
    <h1 class="display">How can we help?</h1>
  </section>
  <section class="wrap quick-help">
    <a href="#orders"><Icon name="truck" /><strong>Track my order</strong></a>
    <a href="#returns"><Icon name="return" /><strong>Start a return</strong></a>
    <a href="#sizing"><Icon name="ruler" /><strong>Size guide</strong></a>
    <a href="#contact"><Icon name="chat" /><strong>Contact us</strong></a>
  </section>
  <div class="wrap help">
    <section id="orders">
      <h2 class="h2">Track my order</h2>
      <form class="track" onsubmit="event.preventDefault(); this.nextElementSibling.hidden = false;">
        <div class="field"><label for="ord">Order number</label><input id="ord" placeholder="#TA12345" required /></div>
        <div class="field"><label for="ord-email">Email</label><input id="ord-email" type="email" required /></div>
        <button class="btn" type="submit">Track</button>
      </form>
      <p class="note" hidden>Order tracking goes live once the store is connected to Shopify.</p>
    </section>
    <section id="shipping"><h2 class="h2">Shipping</h2><p>Free standard shipping on US orders over $75. Orders placed before 2pm ET ship the same business day.</p></section>
    <section id="returns"><h2 class="h2">Returns &amp; exchanges</h2><p>30 days to return or exchange unworn items with tags attached. Refunds go back to your original payment method within 5–10 business days of us receiving your return.</p></section>
    <section id="sizing">
      <h2 class="h2">Size guide</h2>
      <p>Body measurements in inches. Between sizes? Size up for a relaxed fit.</p>
      <button class="btn ghost" type="button" data-open="sizeguide">Open size chart</button>
    </section>
    <section id="faq">
      <h2 class="h2">FAQ</h2>
      {faqs.map(([q, a]) => <details class="faq"><summary>{q}</summary><p>{a}</p></details>)}
    </section>
    <section id="contact">
      <h2 class="h2">Contact us</h2>
      <p>Our team replies within 24 hours, 7 days a week.</p>
      <form class="contact" onsubmit="event.preventDefault(); this.querySelector('.note').hidden = false;">
        <div class="field"><label for="c-name">Name</label><input id="c-name" required /></div>
        <div class="field"><label for="c-email">Email</label><input id="c-email" type="email" required /></div>
        <div class="field" style="grid-column:1/-1"><label for="c-msg">Message</label><textarea id="c-msg" required></textarea></div>
        <button class="btn" type="submit">Send message</button>
        <p class="note" hidden>The contact form isn't connected to an inbox yet.</p>
      </form>
    </section>
    <section id="privacy"><h2 class="h2">Privacy</h2><p>Your privacy policy goes here.</p></section>
    <section id="terms"><h2 class="h2">Terms</h2><p>Your terms of service go here.</p></section>
    <section id="promo-terms"><h2 class="h2">Promo terms</h2><p>Terms for promotions and discount codes go here.</p></section>
  </div>
</Base>
<style>
  .quick-help { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 32px; }
  .quick-help a { background: var(--stone-1); border-radius: 16px; padding: 22px; display: grid; gap: 10px; transition: background .2s; }
  .quick-help a:hover { background: var(--stone-2); }
  .quick-help :global(svg) { width: 26px; height: 26px; }
  .help { max-width: 860px; display: grid; gap: 48px; padding-bottom: 40px; }
  .help section { scroll-margin-top: calc(var(--header-h) + var(--catbar-h) + 20px); }
  .help .h2 { font-size: 26px; margin-bottom: 12px; }
  .help p { color: var(--ink-2); }
  .track, .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: end; }
  .track .btn, .contact .btn { justify-self: start; }
  .note { font-size: 13px; background: var(--stone-2); border-left: 3px solid var(--accent); padding: 10px 12px; border-radius: 10px; }
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; }
  .faq[open] summary::after { content: '–'; }
  .faq p { margin: 0 0 16px; }
  @media (max-width: 760px) { .quick-help { grid-template-columns: 1fr 1fr; } .track, .contact { grid-template-columns: 1fr; } }
</style>
