---
import Base from '../layouts/Base.astro';
// Campaign imagery: add more files to /public/media and list them here.
const looks = [
  { src: '/media/season01-group.jpg', alt: 'THEE ARCTIC Season 01 group look' },
];
---
<Base title="Lookbook">
  <section class="wrap page-hero">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Lookbook</span></nav>
    <p class="eyebrow">Season 01</p>
    <h1 class="display">Lookbook</h1>
  </section>
  <section class="wrap looks">
    <video class="look wide" src="/media/landing-16x9.mp4" poster="/media/landing-16x9.jpg" muted loop playsinline autoplay aria-label="Season 01 campaign film"></video>
    {looks.map((l) => <img class="look" src={l.src} alt={l.alt} loading="lazy" />)}
  </section>
</Base>
<style>
  .looks { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; align-items: stretch; }
  .look { width: 100%; height: 100%; object-fit: cover; border-radius: 18px; background: #0b0b0b; }
  @media (max-width: 760px) { .looks { grid-template-columns: 1fr; } }
</style>
