---
import Base from '../layouts/Base.astro';
import Listing from '../components/Listing.astro';
import { departments, onSale, discount } from '../data/catalog';
const items = onSale().sort((a, b) => discount(b) - discount(a));
---
<Base title="Sale" description="THEE ARCTIC sale.">
  <section class="sale-hero grain">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb" style="color:rgba(255,255,255,.72)"><a href="/">Home</a><span>/</span><span>Sale</span></nav>
      <h1 class="display">Sale</h1>
      <p>Marked-down pieces from every department.</p>
    </div>
  </section>
  <Listing products={items} catChips={departments.filter((d) => items.some((p) => p.dept === d.slug || (p.alsoIn ?? []).includes(d.slug))).map((d) => [d.slug, d.name] as [string, string])} />
</Base>
<style>
  .sale-hero { background: radial-gradient(120% 160% at 88% 0%, #a3434b, var(--accent) 45%, var(--accent-deep)); color: #fff; padding-bottom: 40px; margin-bottom: 24px; }
  h1 { font-size: clamp(56px, 11vw, 170px); margin: 8px 0 10px; }
  p { margin: 0; opacity: .9; }
</style>
