---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { departments, products, inDept, newIn, bestsellers, money } from '../data/catalog';
import { heroSlides, testimonials, community } from '../data/site';
import { garmentSvg } from '../data/garments';

// Spotlight: one standout piece per department, outerwear and sets first
const spotPicks = ['men', 'women', 'sports', 'curve', 'kids', 'men']
  .map((d, k) => inDept(d).filter((p) => ['jacket', 'set', 'hoodie', 'dress'].includes(p.garment))[k] ?? inDept(d)[0]);
const spotData = spotPicks.map((p) => ({
  slug: p.slug, name: p.name, garment: p.garment, colors: p.colors, sizes: p.sizes, img: p.images[0] ?? '',
  price: money(p.salePrice ?? p.price), was: p.salePrice ? money(p.price) : '',
  cat: departments.find((d) => d.slug === p.dept)!.title,
}));

const deptArt: Record<string, { g: string; hex: string; bg: string }> = {
  women: { g: 'dress', hex: '#15171a', bg: 'linear-gradient(170deg,#e4eef7 0%,#b7cde0 100%)' },
  curve: { g: 'set', hex: '#b9a8d6', bg: 'linear-gradient(170deg,#f1e9f6 0%,#cdb9de 100%)' },
  men: { g: 'hoodie', hex: '#1d2b44', bg: 'linear-gradient(170deg,#e9edf1 0%,#aab6c2 100%)' },
  kids: { g: 'jacket', hex: '#3fb49a', bg: 'linear-gradient(170deg,#e6f4f0 0%,#a9d6cb 100%)' },
  sports: { g: 'leggings', hex: '#15171a', bg: 'linear-gradient(170deg,#dceefa 0%,#8ec3e6 100%)' },
  beauty: { g: 'bottle', hex: '#e7b9b8', bg: 'linear-gradient(170deg,#fbf0ec 0%,#e3c3ba 100%)' },
};

const circles: [string, string, string, string][] = [
  ['Dresses', '/women/dresses', 'dress', '#15171a'],
  ['Jeans', '/women/jeans', 'pants', '#4b6a8f'],
  ['Matching Sets', '/women/matching-sets', 'set', '#e7b9b8'],
  ['Hoodies', '/men/hoodies', 'hoodie', '#5d6873'],
  ['Outerwear', '/men/outerwear', 'jacket', '#1d2b44'],
  ['Swim', '/women/swim', 'swim', '#8ec3e6'],
  ['Activewear', '/sports', 'bra', '#3fb49a'],
  ['Shoes', '/men/shoes', 'shoe', '#f1f2f0'],
  ['Kids', '/kids', 'tee', '#d8c6a8'],
  ['Beauty', '/beauty', 'bottle', '#e7b9b8'],
];

const popularTabs = ['women', 'men', 'kids', 'sports'].map((d) => ({
  d, name: departments.find((x) => x.slug === d)!.name,
  items: inDept(d).filter((p) => p.bestseller || p.reviews > 500).slice(0, 10),
}));

const fresh = newIn().filter((_, k) => k % 3 === 0).slice(0, 8);
const editorial = [
  { t: 'Polar Night', s: 'All black everything', href: '/collections/polar-night', bg: 'linear-gradient(170deg,#3a4552,#07090c)', g: 'jacket', hex: '#15171a', light: true },
  { t: 'Whiteout', s: 'Tonal ice', href: '/collections/whiteout', bg: 'linear-gradient(170deg,#ffffff,#c8d3dc)', g: 'set', hex: '#f1f2f0', light: false },
  { t: 'Expedition', s: 'Built for weather', href: '/collections/expedition', bg: 'linear-gradient(170deg,#4b6a8f,#13253a)', g: 'jacket', hex: '#8ec3e6', light: true },
  { t: 'Essentials', s: 'Everyday heavyweights', href: '/collections/arctic-essentials', bg: 'linear-gradient(170deg,#e8e1d6,#a8977d)', g: 'hoodie', hex: '#d8c6a8', light: false },
  { t: 'Arctic Sports', s: 'Move in the cold', href: '/sports', bg: 'linear-gradient(170deg,#3fb49a,#0d3a3f)', g: 'bra', hex: '#15171a', light: true },
];
const driftPick = bestsellers().find((p) => p.garment === 'shoe') ?? products[0];
---
<Base preloader>
  <!-- HERO -->
  <section class="hero" data-hero aria-roledescription="carousel" aria-label="Featured">
    {heroSlides.map((s, k) => (
      <div class={`slide ${s.tone} ${k === 0 ? 'on' : ''}`} style={`background:${s.gradient}`} aria-roledescription="slide" aria-label={`${k + 1} of ${heroSlides.length}`}>
        {s.video && <video src={s.video} poster={s.image} muted loop playsinline autoplay={k === 0} preload="metadata"></video>}
        {!s.video && s.image && <img src={s.image} alt="" class="bg" />}
        <div class="wrap slide-inner">
          <div class="copy">
            <p class="eyebrow">{s.eyebrow}</p>
            <h1 class="display" set:html={s.title.replace('\n', '<br/>')} />
            <p class="lede">{s.text}</p>
            <div class="ctas">
              <a class={`btn ${s.tone === 'light' ? 'light' : ''}`} href={s.href}>{s.cta}</a>
              <a class="btn ghost" href="/lookbook">View lookbook</a>
            </div>
          </div>
        </div>
      </div>
    ))}
    <canvas class="snow" data-snow aria-hidden="true"></canvas>
    <div class="hero-ui wrap">
      <div class="bars">
        {heroSlides.map((s, k) => <button class="bar-btn" data-bar type="button" aria-label={`Go to slide ${k + 1}: ${s.eyebrow}`}><span></span></button>)}
      </div>
      <button class="icon-btn hero-toggle" type="button" data-hero-toggle aria-pressed="false" aria-label="Pause slideshow">
        <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
      </button>
    </div>
  </section>

  <!-- USP strip -->
  <div class="usp">
    <div class="wrap usp-inner">
      <span><Icon name="truck" /> Free shipping over $75</span>
      <span><Icon name="return" /> Free 30-day returns</span>
      <span><Icon name="gift" /> Earn points with Arctic Rewards</span>
      <span><Icon name="lock" /> Secure checkout · Pay in 4</span>
    </div>
  </div>

  <!-- DEPARTMENTS -->
  <section class="section wrap">
    <div class="section-head reveal">
      <div><p class="eyebrow">Shop by department</p><h2 class="h2">The Arctic family</h2></div>
    </div>
    <div class="depts">
      {departments.map((d) => (
        <a class="dept reveal" href={`/${d.slug}`} style={`background:${deptArt[d.slug].bg}`}>
          <div class="dept-art" set:html={garmentSvg(deptArt[d.slug].g as any, deptArt[d.slug].hex)} />
          <div class="dept-copy">
            <span class="eyebrow" style="color:var(--ink-2)">{d.tagline}</span>
            <strong>{d.title}</strong>
          </div>
          <span class="dept-go" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- SPOTLIGHT (streetwear redefined) -->
  <section class="spot" data-spot={JSON.stringify(spotData)} tabindex="0" aria-label="Spotlight">
    <div class="wrap spot-grid">
      <div class="spot-intro">
        <p class="eyebrow">New season · Spotlight</p>
        <h2 class="display spot-title">Streetwear.<br /><span>Redefined.</span></h2>
        <p class="spot-lede">Clean cuts, heavy fabrics, built to be worn anywhere. Swipe through this week's standouts.</p>
        <div class="spot-stats">
          <div><strong>40+</strong><span>Drops a year</span></div>
          <div><strong>6</strong><span>Departments</span></div>
          <div><strong>4.8★</strong><span>Avg. rating</span></div>
        </div>
      </div>
      <div class="spot-stage">
        {spotData.map((s) => (
          <div class="spot-item" data-pos="far-next">
            {s.img ? <img src={s.img} alt={s.name} class="spot-art" /> : <div class="spot-art" set:html={garmentSvg(s.garment, s.colors[0].hex)} />}
          </div>
        ))}
        <div class="spot-nav">
          <button class="nav-btn" type="button" data-spot-prev aria-label="Previous"><Icon name="left" /></button>
          <span class="spot-count" data-spot-count>01 / 06</span>
          <button class="nav-btn" type="button" data-spot-next aria-label="Next"><Icon name="right" /></button>
        </div>
      </div>
      <div class="spot-panel" data-spot-panel aria-live="polite">
        <p class="eyebrow" data-f="cat"></p>
        <h3 class="spot-name" data-f="name"></h3>
        <div class="price spot-price" data-f="price"></div>
        <p class="lbl">Colour</p>
        <div class="spot-sw" data-f="swatches"></div>
        <p class="lbl">Add to bag · pick a size</p>
        <div class="spot-sz" data-f="sizes"></div>
        <a class="link-arrow" data-f="link" href="#">View details</a>
      </div>
    </div>
  </section>

  <!-- CATEGORY CIRCLES -->
  <section class="section wrap" style="padding-bottom:0">
    <div class="section-head reveal"><h2 class="h2">Shop by category</h2></div>
    <div class="circles reveal">
      {circles.map(([label, href, g, hex]) => (
        <a class="circle" href={href}>
          <span class="ring" set:html={garmentSvg(g as any, hex)} />
          <span>{label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- POPULAR PICKS -->
  <section class="section wrap" data-tabs>
    <div class="section-head reveal">
      <div><p class="eyebrow">Trending right now</p><h2 class="h2">Popular picks</h2></div>
      <div class="chips" role="tablist" aria-label="Department">
        {popularTabs.map((t, k) => <button class={`chip ${k === 0 ? 'on' : ''}`} role="tab" type="button" aria-selected={k === 0 ? 'true' : 'false'} aria-controls={`pop-${t.d}`}>{t.name}</button>)}
      </div>
    </div>
    {popularTabs.map((t, k) => (
      <div role="tabpanel" id={`pop-${t.d}`} hidden={k !== 0}>
        <div class="rail" id={`rail-${t.d}`}>{t.items.map((p, i) => <ProductCard product={p} idx={i} />)}</div>
        <div class="rail-foot">
          <a class="link-arrow" href={`/${t.d}?sort=best`}>Shop all {t.name} bestsellers</a>
          <div class="rail-nav">
            <button type="button" data-rail-btn={`rail-${t.d}`} data-dir="prev" aria-label="Scroll left"><Icon name="left" /></button>
            <button type="button" data-rail-btn={`rail-${t.d}`} data-dir="next" aria-label="Scroll right"><Icon name="right" /></button>
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- SALE BANNER + COUNTDOWN -->
  <section class="wrap">
    <a href="/sale" class="sale-banner reveal">
      <div>
        <p class="eyebrow" style="color:#ffd3d6">Arctic Sale · Ends soon</p>
        <h2 class="display">Up to 60% off</h2>
        <p style="margin:0;opacity:.85">Hundreds of styles. Every department. While stock lasts.</p>
      </div>
      <div class="cd" data-countdown aria-label="Time left in the sale">
        <div><b data-cd="d">00</b><span>Days</span></div>
        <div><b data-cd="h">00</b><span>Hrs</span></div>
        <div><b data-cd="m">00</b><span>Min</span></div>
        <div><b data-cd="s">00</b><span>Sec</span></div>
      </div>
      <span class="btn light">Shop sale</span>
    </a>
  </section>

  <!-- EDITORIAL ACCORDION -->
  <section class="section wrap">
    <div class="section-head reveal">
      <h2 class="h2">Express your identity<br />with our unique style</h2>
      <a class="link-arrow" href="/collections">All collections</a>
    </div>
    <div class="editorial reveal">
      {editorial.map((e) => (
        <a class={`ed ${e.light ? 'light' : ''}`} href={e.href} style={`background:${e.bg}`}>
          <div class="ed-art" set:html={garmentSvg(e.g as any, e.hex)} />
          <div class="ed-copy"><strong>{e.t}</strong><span>{e.s}</span></div>
        </a>
      ))}
    </div>
  </section>

  <!-- NEW ARRIVALS -->
  <section class="section wrap" style="padding-top:0">
    <div class="section-head reveal">
      <div><p class="eyebrow">Just landed</p><h2 class="h2">New arrivals</h2></div>
      <a class="link-arrow" href="/new-in">Shop all new</a>
    </div>
    <div class="grid">{fresh.map((p, i) => <ProductCard product={p} idx={i} />)}</div>
  </section>

  <!-- DRIFT: giant word + card -->
  <section class="drift">
    <div class="drift-word display" data-drift aria-hidden="true">ARCTIC</div>
    <div class="wrap drift-inner">
      <div class="drift-card reveal">
        <div class="drift-art" set:html={garmentSvg(driftPick.garment, driftPick.colors[0].hex)} />
        <div>
          <p class="eyebrow">The vibe</p>
          <h2 class="display">Step into<br />your best style</h2>
          <p style="color:var(--muted);max-width:40ch">Pieces made to layer, last and look sharp from the first cold morning to the last night out.</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
            <a class="btn" href="/new-in">Shop new in</a>
            <a class="btn ghost" href={`/products/${driftPick.slug}`}>{driftPick.name}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section wrap">
    <div class="section-head reveal">
      <h2 class="h2">Every fit tells a story.<br />Here's theirs.</h2>
      <div class="rail-nav">
        <button type="button" data-rail-btn="reviews" data-dir="prev" aria-label="Previous reviews"><Icon name="left" /></button>
        <button type="button" data-rail-btn="reviews" data-dir="next" aria-label="Next reviews"><Icon name="right" /></button>
      </div>
    </div>
    <div class="rail reviews" id="reviews">
      {testimonials.map((t) => (
        <figure class="review">
          <div class="stars"><b>{'★'.repeat(t.rating)}{'☆'.repeat(5 - t.rating)}</b></div>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>
            <span class="avatar">{t.name[0]}</span>
            <span><strong>{t.name}</strong><small>Verified buyer · {t.item}</small></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- COMMUNITY -->
  <section class="section wrap" style="padding-top:0">
    <div class="section-head reveal">
      <div><p class="eyebrow">@THEEARCTIC</p><h2 class="h2">Worn by you</h2></div>
      <a class="link-arrow" href="/lookbook">See the lookbook</a>
    </div>
    <div class="community">
      {community.map((c) => (
        <a class="post reveal" href="https://instagram.com/" target="_blank" rel="noopener" style={`background:${c.gradient}`}>
          {c.image && <img src={c.image} alt={`Styled by ${c.handle}`} loading="lazy" />}
          <span class="handle"><Icon name="instagram" /> {c.handle}</span>
        </a>
      ))}
    </div>
    <p style="text-align:center;color:var(--muted);margin-top:20px">Tag <strong style="color:var(--ink)">#THEEARCTIC</strong> for a chance to be featured.</p>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  /* Hero */
  .hero { position: relative; height: min(88svh, 860px); min-height: 560px; overflow: hidden; background: var(--deep); }
  .slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 1s var(--ease), visibility 0s 1s; }
  .slide.on { opacity: 1; visibility: visible; transition: opacity 1s var(--ease); }
  .slide video, .slide .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .slide.light { color: #fff; }
  .slide.light .eyebrow { color: #b9d7ec; }
  .slide-inner { position: relative; height: 100%; display: flex; align-items: flex-end; padding-bottom: clamp(80px, 12vh, 140px); }
  .copy { max-width: 760px; }
  .slide h1 { font-size: clamp(64px, 13vw, 200px); margin: 8px 0 18px; transform: translateY(40px); opacity: 0; transition: transform 1.2s var(--ease) .15s, opacity 1s .15s; }
  .slide.on h1 { transform: none; opacity: 1; }
  .lede { font-size: clamp(15px, 1.4vw, 18px); max-width: 46ch; margin: 0 0 26px; opacity: .88; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .snow { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero-ui { position: absolute; left: 0; right: 0; bottom: 28px; display: flex; align-items: center; gap: 16px; }
  .bars { display: flex; gap: 8px; flex: 1; max-width: 420px; }
  .bar-btn { flex: 1; height: 20px; display: flex; align-items: center; }
  .bar-btn span { display: block; width: 100%; height: 3px; border-radius: 3px; background: rgba(255,255,255,.3); position: relative; overflow: hidden; }
  .bar-btn span::after { content: ''; position: absolute; inset: 0; background: #fff; transform-origin: left; transform: scaleX(var(--p, 0)); }
  .bar-btn.done span::after { transform: scaleX(1); }
  .hero-toggle { color: #fff; background: rgba(255,255,255,.12); }
  .hero-toggle:hover { background: rgba(255,255,255,.22); }
  .hero-toggle :global(.i-play), .hero-toggle[aria-pressed="true"] :global(.i-pause) { display: none; }
  .hero-toggle[aria-pressed="true"] :global(.i-play) { display: block; }
  .bars { background: rgba(12,14,17,.28); backdrop-filter: blur(8px); border-radius: 999px; padding-inline: 14px; }

  .usp { border-bottom: 1px solid var(--line); background: var(--snow); }
  .usp-inner { display: flex; justify-content: space-between; gap: 24px; padding-block: 14px; overflow-x: auto; scrollbar-width: none; }
  .usp span { display: inline-flex; gap: 8px; align-items: center; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .usp :global(svg) { width: 18px; height: 18px; }

  /* Departments */
  .depts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .dept { position: relative; aspect-ratio: 5/4; border-radius: 20px; overflow: hidden; display: flex; align-items: flex-end; padding: 22px; isolation: isolate; }
  .dept-art { position: absolute; right: -4%; top: 6%; width: 58%; z-index: -1; transition: transform .8s var(--ease); }
  .dept:hover .dept-art { transform: translateY(-8px) rotate(-3deg) scale(1.04); }
  .dept-copy { display: grid; gap: 4px; }
  .dept-copy strong { font-family: var(--display); font-weight: 900; font-stretch: 118%; font-size: clamp(20px, 2.3vw, 32px); line-height: .95; text-transform: uppercase; max-width: 9ch; }
  .dept-go { position: absolute; top: 18px; left: 18px; width: 44px; height: 44px; border-radius: 50%; background: #fff; display: grid; place-items: center; transition: transform .3s var(--ease); }
  .dept-go :global(svg) { width: 20px; height: 20px; }
  .dept:hover .dept-go { transform: rotate(-45deg); }
  @media (max-width: 900px) { .depts { grid-template-columns: repeat(2, 1fr); gap: 10px; } .dept { aspect-ratio: 4/5; padding: 16px; } }

  /* Spotlight */
  .spot { background: linear-gradient(180deg, #f6f8fa, #e9eff4); padding-block: clamp(48px, 7vw, 96px); overflow: hidden; outline: none; }
  .spot-grid { display: grid; grid-template-columns: 1fr 1.2fr .9fr; gap: 32px; align-items: center; }
  .spot-title { font-size: clamp(44px, 6vw, 92px); margin: 10px 0 16px; }
  .spot-title span { color: #9aa6b2; }
  .spot-lede { color: var(--muted); max-width: 36ch; margin: 0 0 28px; }
  .spot-stats { display: flex; gap: 28px; }
  .spot-stats div { display: grid; }
  .spot-stats strong { font-family: var(--display); font-size: 26px; font-weight: 800; }
  .spot-stats span { font-size: 12px; color: var(--muted); }
  .spot-stage { position: relative; height: clamp(380px, 46vw, 600px); }
  .spot-item { position: absolute; top: 0; left: 50%; width: 70%; height: calc(100% - 60px); margin-left: -35%; display: grid; place-items: center; transition: transform .9s var(--ease), opacity .7s, filter .7s; cursor: pointer; }
  .spot-art { width: 100%; height: 100%; display: grid; place-items: center; object-fit: contain; }
  .spot-art :global(svg) { width: 100%; height: 100%; filter: drop-shadow(0 30px 40px rgba(13,34,54,.18)); }
  .spot-item[data-pos="active"] { transform: none; opacity: 1; filter: none; z-index: 3; cursor: default; }
  .spot-item[data-pos="prev"] { transform: translateX(-62%) scale(.62); opacity: .28; filter: blur(3px) grayscale(.4); z-index: 2; }
  .spot-item[data-pos="next"] { transform: translateX(62%) scale(.62); opacity: .28; filter: blur(3px) grayscale(.4); z-index: 2; }
  .spot-item[data-pos="far-prev"] { transform: translateX(-110%) scale(.4); opacity: 0; pointer-events: none; }
  .spot-item[data-pos="far-next"] { transform: translateX(110%) scale(.4); opacity: 0; pointer-events: none; }
  .spot-nav { position: absolute; bottom: 0; left: 0; right: 0; display: flex; justify-content: center; align-items: center; gap: 18px; z-index: 4; }
  .nav-btn { width: 46px; height: 46px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: 0 6px 20px rgba(13,34,54,.1); transition: transform .2s; }
  .nav-btn:hover { transform: scale(1.08); }
  .nav-btn :global(svg) { width: 20px; height: 20px; }
  .spot-count { font-family: var(--display); font-weight: 700; font-size: 14px; letter-spacing: .1em; min-width: 70px; text-align: center; }
  .spot-panel { background: rgba(255,255,255,.75); backdrop-filter: blur(12px); border-radius: 20px; padding: 26px; box-shadow: 0 20px 50px -30px rgba(13,34,54,.35); transition: opacity .22s, filter .22s, transform .22s; }
  .spot-panel.swap { opacity: 0; filter: blur(6px); transform: translateY(8px); }
  .spot-name { font-family: var(--display); font-weight: 800; font-stretch: 110%; text-transform: uppercase; font-size: clamp(22px, 2.2vw, 32px); line-height: 1; margin: 8px 0 10px; }
  .spot-price { font-size: 18px; margin-bottom: 18px; }
  .lbl { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .spot-sw { display: flex; gap: 8px; margin-bottom: 18px; }
  .spot-panel :global(.sw) { width: 26px; height: 26px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
  .spot-panel :global(.sw[aria-pressed="true"]) { box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--ink); }
  .spot-sz { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .spot-panel :global(.sz) { min-width: 42px; height: 38px; padding-inline: 8px; border-radius: 10px; border: 1px solid var(--line); background: #fff; font-size: 13px; font-weight: 600; transition: all .2s; }
  .spot-panel :global(.sz:hover) { background: var(--ink); color: #fff; border-color: var(--ink); }
  @media (max-width: 1080px) {
    .spot-grid { grid-template-columns: 1fr; }
    .spot-stats { display: none; }
    .spot-stage { height: 440px; }
  }

  /* Category circles */
