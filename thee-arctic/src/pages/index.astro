---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { departments, products, inDept, newIn, onSale, collections, inCollection, money, priceOf } from '../data/catalog';
import { hero, testimonials, community } from '../data/site';
import { looks, lookItems } from '../data/looks';

const hasProducts = products.length > 0;

// Spotlight: up to six pieces that have photos
const spotData = products.filter((p) => p.images.length && p.sizes.length && priceOf(p) !== undefined).slice(0, 6).map((p) => ({
  slug: p.slug, name: p.name, garment: p.garment, colors: p.colors, sizes: p.sizes, img: p.images[0],
  price: money(priceOf(p)!), was: p.salePrice && p.price ? money(p.price) : '',
  cat: departments.find((d) => d.slug === p.dept)!.title,
}));

const popularTabs = departments
  .map((d) => ({ d: d.slug, name: d.name, items: [...inDept(d.slug)].sort((a, b) => +b.bestseller - +a.bestseller).slice(0, 10) }))
  .filter((t) => t.items.length);
const fresh = newIn().slice(0, 8);
const saleCount = onSale().length;
const liveCollections = collections.map((c) => ({ ...c, count: inCollection(c.slug).length })).filter((c) => c.count);
const categoryLinks = departments.flatMap((d) => d.categories.slice(0, 2).map((c) => ({ label: `${d.name} · ${c.name}`, href: `/${d.slug}/${c.slug}` })));
---
<Base preloader>
  <!-- HERO: brand landing film -->
  <section class="hero" data-hero aria-label="THEE ARCTIC Season 01">
    <video
      class="hero-video"
      data-wide={hero.wide.video} data-wide-poster={hero.wide.poster}
      data-tall={hero.tall.video} data-tall-poster={hero.tall.poster}
      src={hero.wide.video} poster={hero.wide.poster}
      muted loop playsinline autoplay preload="auto"
      aria-label="THEE ARCTIC Season 01 campaign film"
    ></video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-ui">
      <div>
        <p class="eyebrow hero-label">{hero.label}</p>
        <a class="btn light" href={hero.cta.href}>{hero.cta.text}</a>
      </div>
      <button class="icon-btn hero-toggle" type="button" data-hero-toggle aria-pressed="false" aria-label="Pause video">
        <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
      </button>
    </div>
  </section>

  <!-- DEPARTMENTS -->
  <section class="section wrap">
    <div class="section-head reveal">
      <div><p class="eyebrow">Shop by department</p><h2 class="h2">The Arctic family</h2></div>
    </div>
    <div class="depts">
      {departments.map((d, k) => (
        <a class="dept reveal" href={`/${d.slug}`}>
          <span class="dept-no">{String(k + 1).padStart(2, '0')}</span>
          <div class="dept-copy">
            <strong>{d.title}</strong>
            <span>{d.tagline}</span>
          </div>
          <span class="dept-go" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </section>

  {looks.length > 0 && (
    <section class="section wrap" style="padding-top:0">
      <div class="section-head reveal">
        <div><p class="eyebrow">Pieces that go together</p><h2 class="h2">Shop the look</h2></div>
        <div class="rail-nav">
          <button type="button" data-rail-btn="looks" data-dir="prev" aria-label="Previous looks"><Icon name="left" /></button>
          <button type="button" data-rail-btn="looks" data-dir="next" aria-label="Next looks"><Icon name="right" /></button>
        </div>
      </div>
      <div class="rail looks-rail" id="looks">
        {looks.map((l, k) => (
          <a class="look-tile" href={`/lookbook#${l.id}`}>
            <img src={l.image} alt={`Look ${String(k + 1).padStart(2, '0')}`} loading="lazy" />
            <span>Look {String(k + 1).padStart(2, '0')}{lookItems(l).length > 0 && ` · ${lookItems(l).length} piece${lookItems(l).length > 1 ? 's' : ''}`}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {spotData.length > 0 && (
    <section class="spot" data-spot={JSON.stringify(spotData)} tabindex="0" aria-label="Spotlight">
      <div class="wrap spot-grid">
        <div class="spot-intro">
          <p class="eyebrow">Season 01 · Spotlight</p>
          <h2 class="display spot-title">Streetwear.<br /><span>Redefined.</span></h2>
          <p class="spot-lede">Swipe through this season's standouts.</p>
        </div>
        <div class="spot-stage">
          {spotData.map((s) => (
            <div class="spot-item" data-pos="far-next"><img src={s.img} alt={s.name} class="spot-art" /></div>
          ))}
          <div class="spot-nav">
            <button class="nav-btn" type="button" data-spot-prev aria-label="Previous"><Icon name="left" /></button>
            <span class="spot-count" data-spot-count></span>
            <button class="nav-btn" type="button" data-spot-next aria-label="Next"><Icon name="right" /></button>
          </div>
        </div>
        <div class="spot-panel" data-spot-panel aria-live="polite">
          <p class="eyebrow" data-f="cat"></p>
          <h3 class="spot-name" data-f="name"></h3>
          <div class="price spot-price" data-f="price"></div>
          <p class="lbl">Colour</p>
          <div class="spot-sw" data-f="swatches"></div>
          <p class="lbl">Add to bag · pick a size</p>
          <div class="spot-sz" data-f="sizes"></div>
          <a class="link-arrow" data-f="link" href="#">View details</a>
        </div>
      </div>
    </section>
  )}

  <!-- CATEGORIES -->
  <section class="section wrap" style="padding-top:0">
    <div class="section-head reveal"><h2 class="h2">Shop by category</h2></div>
    <nav class="chips cat-links reveal" aria-label="Categories">
      {categoryLinks.map((c) => <a class="chip" href={c.href}>{c.label}</a>)}
    </nav>
  </section>

  {popularTabs.length > 0 && (
    <section class="section wrap" data-tabs style="padding-top:0">
      <div class="section-head reveal">
        <div><p class="eyebrow">Trending right now</p><h2 class="h2">Popular picks</h2></div>
        <div class="chips" role="tablist" aria-label="Department">
          {popularTabs.map((t, k) => <button class={`chip ${k === 0 ? 'on' : ''}`} role="tab" type="button" aria-selected={k === 0 ? 'true' : 'false'} aria-controls={`pop-${t.d}`}>{t.name}</button>)}
        </div>
      </div>
      {popularTabs.map((t, k) => (
        <div role="tabpanel" id={`pop-${t.d}`} hidden={k !== 0}>
          <div class="rail" id={`rail-${t.d}`}>{t.items.map((p, i) => <ProductCard product={p} idx={i} />)}</div>
          <div class="rail-foot">
            <a class="link-arrow" href={`/${t.d}?sort=best`}>Shop all {t.name}</a>
            <div class="rail-nav">
              <button type="button" data-rail-btn={`rail-${t.d}`} data-dir="prev" aria-label="Scroll left"><Icon name="left" /></button>
              <button type="button" data-rail-btn={`rail-${t.d}`} data-dir="next" aria-label="Scroll right"><Icon name="right" /></button>
            </div>
          </div>
        </div>
      ))}
    </section>
  )}

  {saleCount > 0 && (
    <section class="wrap">
      <a href="/sale" class="sale-banner reveal">
        <div>
          <p class="eyebrow" style="color:#ffd3d6">Sale</p>
          <h2 class="display">{saleCount} styles marked down</h2>
        </div>
        <span class="btn light">Shop sale</span>
      </a>
    </section>
  )}

  {liveCollections.length > 0 && (
    <section class="section wrap">
      <div class="section-head reveal"><h2 class="h2">Collections</h2><a class="link-arrow" href="/collections">All collections</a></div>
      <div class="chips">{liveCollections.map((c) => <a class="chip" href={`/collections/${c.slug}`}>{c.name} · {c.count}</a>)}</div>
    </section>
  )}

  {fresh.length > 0 && (
    <section class="section wrap" style="padding-top:0">
      <div class="section-head reveal">
        <div><p class="eyebrow">Just landed</p><h2 class="h2">New arrivals</h2></div>
        <a class="link-arrow" href="/new-in">Shop all new</a>
      </div>
      <div class="grid">{fresh.map((p, i) => <ProductCard product={p} idx={i} />)}</div>
    </section>
  )}

  <!-- SEASON 01: giant word + card with the campaign still -->
  <section class="drift">
    <div class="drift-word display" data-drift aria-hidden="true">ARCTIC</div>
    <div class="wrap drift-inner">
      <div class="drift-card reveal">
        <img class="drift-img" src="/media/season01-group.jpg" alt="Three models in THEE ARCTIC Season 01" loading="lazy" />
        <div>
          <p class="eyebrow">Season 01</p>
          <h2 class="display">Step into<br />your best style</h2>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
            {hasProducts
              ? <a class="btn" href={hero.cta.href}>Shop Season 01</a>
              : <a class="btn" href="#nl-email">Get early access</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section wrap">
      <div class="section-head reveal">
        <h2 class="h2">Every fit tells a story.<br />Here's theirs.</h2>
        <div class="rail-nav">
          <button type="button" data-rail-btn="reviews" data-dir="prev" aria-label="Previous reviews"><Icon name="left" /></button>
          <button type="button" data-rail-btn="reviews" data-dir="next" aria-label="Next reviews"><Icon name="right" /></button>
        </div>
      </div>
      <div class="rail reviews" id="reviews">
        {testimonials.map((t) => (
          <figure class="review">
            <div class="stars"><b>{'★'.repeat(t.rating)}{'☆'.repeat(5 - t.rating)}</b></div>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><span class="avatar">{t.name[0]}</span><span><strong>{t.name}</strong><small>{t.item}</small></span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {community.length > 0 && (
    <section class="section wrap">
      <div class="section-head reveal"><div><p class="eyebrow">@THEEARCTIC</p><h2 class="h2">Worn by you</h2></div></div>
      <div class="community">
        {community.map((c) => (
          <a class="post reveal" href={c.href ?? '#'} target="_blank" rel="noopener">
            <img src={c.image} alt={`Styled by ${c.handle}`} loading="lazy" />
            <span class="handle"><Icon name="instagram" /> {c.handle}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  /* Hero */
  .hero { position: relative; height: calc(100svh - var(--header-h) - 36px); min-height: 520px; overflow: hidden; background: #0b0b0b; }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,.45)); pointer-events: none; }
  .hero-ui { position: absolute; left: 0; right: 0; bottom: clamp(24px, 5vh, 48px); display: flex; justify-content: space-between; align-items: end; gap: 16px; }
  .hero-label { color: rgba(255,255,255,.75); margin: 0 0 12px; }
  .hero-toggle { color: #fff; background: rgba(255,255,255,.14); }
  .hero-toggle:hover { background: rgba(255,255,255,.26); }
  .hero-toggle :global(.i-play), .hero-toggle[aria-pressed="true"] :global(.i-pause) { display: none; }
  .hero-toggle[aria-pressed="true"] :global(.i-play) { display: block; }

  /* Departments */
  .depts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
  .dept { position: relative; background: #fff; min-height: 220px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; transition: background .35s var(--ease), color .35s; }
  .dept:hover { background: var(--ink); color: #fff; }
  .dept-no { font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .1em; opacity: .55; }
  .dept-copy { display: grid; gap: 6px; }
  .dept-copy strong { font-family: var(--display); font-weight: 900; font-stretch: 118%; font-size: clamp(22px, 2.6vw, 36px); line-height: .95; text-transform: uppercase; max-width: 10ch; }
  .dept-copy span { font-size: 13px; opacity: .7; }
  .dept-go { position: absolute; top: 20px; right: 20px; width: 44px; height: 44px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px currentColor; display: grid; place-items: center; transition: transform .3s var(--ease); }
  .dept-go :global(svg) { width: 20px; height: 20px; }
  .dept:hover .dept-go { transform: rotate(-45deg); }
  @media (max-width: 900px) { .depts { grid-template-columns: repeat(2, 1fr); } .dept { min-height: 170px; padding: 18px; } .dept-go { width: 36px; height: 36px; top: 14px; right: 14px; } }

  .cat-links { flex-wrap: wrap; overflow: visible; }
  .looks-rail { grid-auto-columns: calc((100% - 16px * 3) / 3.3); }
  @media (max-width: 900px) { .looks-rail { grid-auto-columns: 80%; } }
  .look-tile { position: relative; display: block; aspect-ratio: 4/5; border-radius: 18px; overflow: hidden; background: var(--snow); }
  .look-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .look-tile:hover img { transform: scale(1.03); }
  .look-tile span { position: absolute; left: 12px; bottom: 12px; background: #fff; border-radius: 999px; padding: 7px 14px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

  /* Spotlight (appears once products with photos exist) */
  .spot { background: var(--snow); padding-block: clamp(48px, 7vw, 96px); overflow: hidden; outline: none; }
  .spot-grid { display: grid; grid-template-columns: 1fr 1.2fr .9fr; gap: 32px; align-items: center; }
  .spot-title { font-size: clamp(44px, 6vw, 92px); margin: 10px 0 16px; }
  .spot-title span { color: #9a9a96; }
  .spot-lede { color: var(--muted); max-width: 36ch; margin: 0; }
  .spot-stage { position: relative; height: clamp(380px, 46vw, 600px); }
  .spot-item { position: absolute; top: 0; left: 50%; width: 70%; height: calc(100% - 60px); margin-left: -35%; transition: transform .9s var(--ease), opacity .7s, filter .7s; cursor: pointer; }
  .spot-art { width: 100%; height: 100%; object-fit: contain; }
  .spot-item[data-pos="active"] { transform: none; opacity: 1; filter: none; z-index: 3; cursor: default; }
  .spot-item[data-pos="prev"] { transform: translateX(-62%) scale(.62); opacity: .28; filter: blur(3px) grayscale(.4); z-index: 2; }
  .spot-item[data-pos="next"] { transform: translateX(62%) scale(.62); opacity: .28; filter: blur(3px) grayscale(.4); z-index: 2; }
  .spot-item[data-pos="far-prev"] { transform: translateX(-110%) scale(.4); opacity: 0; pointer-events: none; }
  .spot-item[data-pos="far-next"] { transform: translateX(110%) scale(.4); opacity: 0; pointer-events: none; }
  .spot-nav { position: absolute; bottom: 0; left: 0; right: 0; display: flex; justify-content: center; align-items: center; gap: 18px; z-index: 4; }
  .nav-btn { width: 46px; height: 46px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: 0 6px 20px rgba(0,0,0,.1); }
  .nav-btn :global(svg) { width: 20px; height: 20px; }
  .spot-count { font-family: var(--display); font-weight: 700; font-size: 14px; letter-spacing: .1em; min-width: 70px; text-align: center; }
  .spot-panel { background: #fff; border-radius: 20px; padding: 26px; box-shadow: 0 20px 50px -30px rgba(0,0,0,.35); transition: opacity .22s, filter .22s, transform .22s; }
  .spot-panel.swap { opacity: 0; filter: blur(6px); transform: translateY(8px); }
  .spot-name { font-family: var(--display); font-weight: 800; font-stretch: 110%; text-transform: uppercase; font-size: clamp(22px, 2.2vw, 32px); line-height: 1; margin: 8px 0 10px; }
  .spot-price { font-size: 18px; margin-bottom: 18px; }
  .lbl { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .spot-sw { display: flex; gap: 8px; margin-bottom: 18px; }
  .spot-panel :global(.sw) { width: 26px; height: 26px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
  .spot-panel :global(.sw[aria-pressed="true"]) { box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--ink); }
  .spot-sz { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .spot-panel :global(.sz) { min-width: 42px; height: 38px; padding-inline: 8px; border-radius: 10px; border: 1px solid var(--line); background: #fff; font-size: 13px; font-weight: 600; }
  .spot-panel :global(.sz:hover) { background: var(--ink); color: #fff; border-color: var(--ink); }
  @media (max-width: 1080px) { .spot-grid { grid-template-columns: 1fr; } .spot-stage { height: 440px; } }

  .rail-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; }
  .sale-banner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; background: var(--sale); color: #fff; border-radius: 24px; padding: clamp(24px, 4vw, 48px); }
  .sale-banner h2 { font-size: clamp(32px, 5vw, 64px); margin: 6px 0 0; }

  /* Season 01 */
  .drift { position: relative; background: #0b0b0b; color: #fff; padding-block: clamp(80px, 12vw, 180px); overflow: hidden; margin-top: clamp(24px, 4vw, 64px); }
  .drift-word { position: absolute; top: 50%; left: 0; right: 0; margin-top: -0.45em; font-size: clamp(140px, 30vw, 520px); font-weight: 900; font-stretch: 125%; color: transparent; -webkit-text-stroke: 1.5px rgba(255,255,255,.16); white-space: nowrap; text-align: center; line-height: .9; will-change: transform; }
  .drift-inner { position: relative; display: flex; justify-content: center; }
  .drift-card { display: grid; grid-template-columns: 240px 1fr; gap: 32px; align-items: center; background: #fff; color: var(--ink); border-radius: 24px; padding: 24px; max-width: 760px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.6); }
  .drift-card h2 { font-size: clamp(32px, 4.4vw, 60px); margin: 6px 0 0; }
  .drift-img { width: 100%; aspect-ratio: 9/14; object-fit: cover; border-radius: 16px; }
  @media (max-width: 640px) { .drift-card { grid-template-columns: 1fr; } .drift-img { aspect-ratio: 4/5; } }

  .reviews { grid-auto-columns: calc((100% - 16px * 2) / 3); }
  @media (max-width: 900px) { .reviews { grid-auto-columns: 85%; } }
  .review { margin: 0; background: var(--snow); border-radius: 20px; padding: 26px; display: flex; flex-direction: column; gap: 16px; }
  .review blockquote { margin: 0; font-size: 17px; line-height: 1.45; font-weight: 500; flex: 1; }
  .review figcaption { display: flex; gap: 12px; align-items: center; }
  .review figcaption > span:last-child { display: grid; }
  .review small { color: var(--muted); font-size: 12px; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-weight: 700; }
  .community { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
  .post { position: relative; aspect-ratio: 4/5; border-radius: 16px; overflow: hidden; display: block; background: var(--snow); }
  .post img { width: 100%; height: 100%; object-fit: cover; }
  .handle { position: absolute; left: 10px; bottom: 10px; display: inline-flex; gap: 6px; align-items: center; font-size: 12px; font-weight: 600; color: #fff; background: rgba(0,0,0,.35); padding: 5px 9px; border-radius: 999px; }
  .handle :global(svg) { width: 14px; height: 14px; }
  @media (max-width: 900px) { .community { grid-template-columns: repeat(3, 1fr); } }
</style>
