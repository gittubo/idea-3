---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { departments, products, inDept, newIn, priceOf } from '../data/catalog';
import { hero, testimonials, community } from '../data/site';
import { looks, lookItems } from '../data/looks';
import { shops, inShop, shopCover, catbar, getShop } from '../data/shops';

// Spotlight: pieces with photos and a price (appears once prices exist)
const spotData = products.filter((p) => p.images.length && p.sizes.length && priceOf(p) !== undefined).slice(0, 6).map((p) => ({
  slug: p.slug, name: p.name, garment: p.garment, colors: p.colors, sizes: p.sizes, img: p.images[0],
  price: priceOf(p)!, was: p.salePrice && p.price ? p.price : 0,
  cat: departments.find((d) => d.slug === p.dept)!.title,
}));

// Department bento: look photos where the brand has them
const lookFor = (d: string, prefer?: string) => (prefer && looks.find((l) => l.id === prefer)) || looks.find((l) => l.dept === d);
const bento = [
  { d: 'women', size: 'xl', img: lookFor('women', 'look-13')?.image },
  { d: 'men', size: 'lg', img: lookFor('men', 'look-06')?.image },
  { d: 'sports', size: 'md', img: lookFor('sports')?.image },
  { d: 'curve', size: 'sm' },
  { d: 'kids', size: 'sm' },
  { d: 'beauty', size: 'sm' },
].map((b) => ({ ...b, dept: departments.find((x) => x.slug === b.d)!, count: inDept(b.d).length }));

const categoryTiles = catbar.filter((s) => s !== 'clothing').map((s) => getShop(s)!).map((s) => ({ s, img: shopCover(s), n: inShop(s).length })).filter((t) => t.n > 0 && t.img);
const trends = shops.filter((s) => s.trend).map((s) => ({ s, img: shopCover(s), n: inShop(s).length })).filter((t) => t.n > 0);
const latestTabs = [
  { id: 'new', name: 'New In', items: newIn().slice(0, 12), href: '/new-in' },
  ...['dresses', 'matching-sets', 'jackets', 'shoes', 'accessories'].map((slug) => {
    const s = getShop(slug)!;
    return { id: slug, name: s.name, items: inShop(s).slice(0, 12), href: `/shop/${slug}` };
  }),
].filter((t) => t.items.length);
---
<Base preloader>
  <!-- HERO: brand landing film -->
  <section class="hero" data-hero aria-label="THEE ARCTIC Season 01">
    <video
      class="hero-video"
      data-wide={hero.wide.video} data-wide-poster={hero.wide.poster}
      data-tall={hero.tall.video} data-tall-poster={hero.tall.poster}
      src={hero.wide.video} poster={hero.wide.poster}
      muted loop playsinline autoplay preload="auto"
      aria-label="THEE ARCTIC Season 01 campaign film"
    ></video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-ui">
      <div class="hero-copy">
        <h1 class="display hero-title">THEE ARCTIC <span class="serif">Season 01</span></h1>
        <div class="hero-ctas">
          <a class="btn light" href={hero.cta.href}>Shop new in <span class="ico"><Icon name="arrow-ur" /></span></a>
          <a class="hero-link" href="/lookbook">View the lookbook</a>
        </div>
      </div>
      <button class="icon-btn hero-toggle" type="button" data-hero-toggle aria-pressed="false" aria-label="Pause video">
        <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
      </button>
    </div>
  </section>

  <!-- DEPARTMENTS: asymmetric bento -->
  <section class="section wrap">
    <div class="section-head reveal">
      <div><span class="eyebrow tag">Shop by department</span><h2 class="h2">One house, <span class="serif">every wardrobe.</span></h2></div>
    </div>
    <div class="bento">
      {bento.map((b) => (
        <a class={`tile tile-${b.size} reveal ${b.img ? 'has-img' : ''}`} href={`/${b.dept.slug}`}>
          {b.img && <img src={b.img} alt="" loading="lazy" />}
          <div class="tile-copy">
            <span class="tile-meta">{b.count > 0 ? `${b.count} pieces` : 'Coming soon'}</span>
            <strong>{b.dept.title}</strong>
            {b.size !== 'sm' && <span class="tile-tag">{b.dept.tagline}</span>}
          </div>
          <span class="tile-go" aria-hidden="true"><Icon name="arrow-ur" /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- SHOP BY CATEGORY -->
  {categoryTiles.length > 0 && (
    <section class="wrap cats-sec">
      <div class="section-head reveal">
        <div><span class="eyebrow tag">Shop by category</span><h2 class="h2">Find your <span class="serif">piece.</span></h2></div>
        <div class="rail-nav">
          <button type="button" data-rail-btn="cats" data-dir="prev" aria-label="Scroll categories left"><Icon name="left" /></button>
          <button type="button" data-rail-btn="cats" data-dir="next" aria-label="Scroll categories right"><Icon name="right" /></button>
        </div>
      </div>
      <div class="rail cats" id="cats">
        {categoryTiles.map((t) => (
          <a class="cat-tile" href={`/shop/${t.s.slug}`}>
            <span class="cat-img"><img src={t.img} alt="" loading="lazy" /></span>
            <span class="cat-name">{t.s.name}</span>
            <span class="cat-n tnum">{t.n}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- THE TREND REPORT: editorial split -->
  {trends.length > 0 && (
    <section class="section wrap trend">
      <div class="trend-intro reveal">
        <span class="eyebrow tag">The trend report</span>
        <h2 class="display trend-title">What we're <span class="serif">wearing now.</span></h2>
        <p>Four edits pulled from Season 01. Leather, tailoring, satin and denim, cut the THEE ARCTIC way.</p>
        <a class="link-arrow" href="/shop/leather">Start with leather</a>
      </div>
      <div class="trend-grid">
        {trends.map((t, k) => (
          <a class={`trend-card reveal ${k % 2 ? 'offset' : ''}`} href={`/shop/${t.s.slug}`}>
            <span class="trend-img">{t.img && <img src={t.img} alt="" loading="lazy" />}</span>
            <span class="trend-meta"><strong>{t.s.name}</strong><span class="tnum">{t.n} pieces</span></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- SHOP THE LATEST -->
  {latestTabs.length > 0 && (
    <section class="section wrap" data-tabs style="padding-top:0">
      <div class="section-head reveal latest-head">
        <div><span class="eyebrow tag">Shop the latest</span><h2 class="h2">Just <span class="serif">landed.</span></h2></div>
        <div class="chips" role="tablist" aria-label="Shop the latest">
          {latestTabs.map((t, k) => <button class={`chip ${k === 0 ? 'on' : ''}`} role="tab" type="button" aria-selected={k === 0 ? 'true' : 'false'} aria-controls={`latest-${t.id}`}>{t.name}</button>)}
        </div>
      </div>
      {latestTabs.map((t, k) => (
        <div role="tabpanel" id={`latest-${t.id}`} hidden={k !== 0}>
          <div class="rail" id={`rail-${t.id}`}>{t.items.map((p, i) => <ProductCard product={p} idx={i} />)}</div>
          <div class="rail-foot">
            <a class="link-arrow" href={t.href}>Shop all {t.name.toLowerCase()}</a>
            <div class="rail-nav">
              <button type="button" data-rail-btn={`rail-${t.id}`} data-dir="prev" aria-label="Scroll left"><Icon name="left" /></button>
              <button type="button" data-rail-btn={`rail-${t.id}`} data-dir="next" aria-label="Scroll right"><Icon name="right" /></button>
            </div>
          </div>
        </div>
      ))}
    </section>
  )}

  <!-- SHOP THE LOOK -->
  {looks.length > 0 && (
    <section class="section wrap" style="padding-top:0">
      <div class="section-head reveal">
        <div><span class="eyebrow tag">Pieces that go together</span><h2 class="h2">Shop the <span class="serif">look.</span></h2></div>
        <div class="rail-nav">
          <button type="button" data-rail-btn="looks" data-dir="prev" aria-label="Previous looks"><Icon name="left" /></button>
          <button type="button" data-rail-btn="looks" data-dir="next" aria-label="Next looks"><Icon name="right" /></button>
        </div>
      </div>
      <div class="rail looks-rail" id="looks">
        {looks.map((l, k) => (
          <a class="look-tile" href={`/lookbook#${l.id}`}>
            <img src={l.image} alt={`Look ${String(k + 1).padStart(2, '0')}`} loading="lazy" />
            <span>Look {String(k + 1).padStart(2, '0')}{lookItems(l).length > 0 && ` · ${lookItems(l).length} piece${lookItems(l).length > 1 ? 's' : ''}`}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {spotData.length > 0 && (
    <section class="spot" data-spot={JSON.stringify(spotData)} tabindex="0" aria-label="Spotlight">
      <div class="wrap spot-grid">
        <div class="spot-intro">
          <span class="eyebrow tag">Season 01 · Spotlight</span>
          <h2 class="display spot-title">Streetwear, <span class="serif">redefined.</span></h2>
        </div>
        <div class="spot-stage">
          {spotData.map((s) => <div class="spot-item" data-pos="far-next"><img src={s.img} alt={s.name} class="spot-art" /></div>)}
          <div class="spot-nav">
            <button class="nav-btn" type="button" data-spot-prev aria-label="Previous"><Icon name="left" /></button>
            <span class="spot-count tnum" data-spot-count></span>
            <button class="nav-btn" type="button" data-spot-next aria-label="Next"><Icon name="right" /></button>
          </div>
        </div>
        <div class="bezel"><div class="core spot-panel" data-spot-panel aria-live="polite">
          <p class="eyebrow" data-f="cat"></p>
          <h3 class="spot-name" data-f="name"></h3>
          <div class="price spot-price" data-f="price"></div>
          <p class="lbl">Colour</p>
          <div class="spot-sw" data-f="swatches"></div>
          <p class="lbl">Add to bag · pick a size</p>
          <div class="spot-sz" data-f="sizes"></div>
          <a class="link-arrow" data-f="link" href="#">View details</a>
        </div></div>
      </div>
    </section>
  )}

  <!-- SEASON 01 BAND -->
  <section class="season">
    <div class="season-word display" data-drift aria-hidden="true">THEE ARCTIC</div>
    <div class="wrap season-inner">
      <div class="bezel dark reveal season-card-wrap">
        <div class="core season-card">
          <img class="season-img" src="/media/season01-group.jpg" alt="Three models in THEE ARCTIC Season 01" loading="lazy" />
          <div>
            <span class="eyebrow" style="color:var(--on-dark-muted)">Season 01</span>
            <h2 class="display season-title">Step into <span class="serif">your best style.</span></h2>
            <p>Tailoring, leather, satin and denim. Pieces made to be worn together.</p>
            <a class="btn light" href="/collections/pieces-that-go-together">Pieces that go together <span class="ico"><Icon name="arrow-ur" /></span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RECENTLY VIEWED (filled in the browser) -->
  <section class="section wrap" data-recent="" hidden>
    <div class="section-head"><div><span class="eyebrow tag">For you</span><h2 class="h2">Recently <span class="serif">viewed.</span></h2></div><a class="link-arrow" href="/recently-viewed">See all</a></div>
    <div class="rail" data-recent-rail></div>
  </section>

  {testimonials.length > 0 && (
    <section class="section wrap">
      <div class="section-head reveal"><h2 class="h2">Every fit tells a <span class="serif">story.</span></h2></div>
      <div class="rail reviews" id="reviews">
        {testimonials.map((t) => (
          <figure class="review">
            <div class="stars"><b>{'★'.repeat(t.rating)}{'☆'.repeat(5 - t.rating)}</b></div>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><strong>{t.name}</strong> · {t.item}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {community.length > 0 && (
    <section class="section wrap">
      <div class="section-head reveal"><div><span class="eyebrow tag">@THEEARCTIC</span><h2 class="h2">Worn by <span class="serif">you.</span></h2></div></div>
      <div class="community">
        {community.map((c) => (
          <a class="post reveal" href={c.href ?? '#'} target="_blank" rel="noopener">
            <img src={c.image} alt={`Styled by ${c.handle}`} loading="lazy" />
            <span class="handle"><Icon name="instagram" /> {c.handle}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  /* Hero */
  .hero { position: relative; height: calc(100svh - var(--header-h) - var(--catbar-h) - 34px); min-height: 560px; overflow: hidden; background: var(--deep); }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { position: absolute; inset: 0; background: radial-gradient(120% 70% at 30% 110%, rgba(23,21,18,.7), transparent 60%), linear-gradient(180deg, transparent 55%, rgba(23,21,18,.35)); pointer-events: none; }
  .hero-ui { position: absolute; left: 0; right: 0; bottom: clamp(28px, 6vh, 64px); display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .hero-copy { max-width: 72rem; color: #fff; }
  .hero-title { font-size: clamp(40px, 6.4vw, 104px); margin: 0 0 28px; color: #fff; }
  .hero-title .serif { display: block; font-size: 1.04em; }
  .hero-ctas { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
  .hero-link { color: #fff; font-size: 12px; font-weight: 550; letter-spacing: .14em; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,.6); padding-bottom: 3px; }
  .hero-toggle { color: #fff; background: rgba(255,255,255,.14); }
  .hero-toggle:hover { background: rgba(255,255,255,.26); }
  .hero-toggle :global(.i-play), .hero-toggle[aria-pressed="true"] :global(.i-pause) { display: none; }
  .hero-toggle[aria-pressed="true"] :global(.i-play) { display: block; }

  /* Department bento: 12 columns, rows interlock with no gaps (7+5 | 7+5 | 6+2+2+2) */
  .bento { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: clamp(200px, 21vw, 330px); grid-auto-flow: dense; gap: 12px; }
  .tile { position: relative; overflow: hidden; border-radius: 22px; background: var(--stone-1); display: flex; align-items: flex-end; padding: clamp(18px, 2vw, 28px); isolation: isolate; }
  .tile-xl { grid-column: span 7; grid-row: span 2; }
  .tile-lg { grid-column: span 5; grid-row: span 2; }
  .tile-md { grid-column: span 6; }
  .tile-sm { grid-column: span 2; background: var(--stone-2); }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.4s var(--ease); }
  .tile.has-img::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 45%, rgba(23,21,18,.62)); }
  .tile:hover img { transform: scale(1.04); }
  .tile.has-img { color: #fff; }
  .tile-copy { display: grid; gap: 6px; }
  .tile-copy strong { font-weight: 560; letter-spacing: -.035em; font-size: clamp(22px, 2.6vw, 40px); line-height: 1; }
  .tile-sm .tile-copy strong { font-size: clamp(15px, 1.3vw, 19px); letter-spacing: -.01em; }
  .tile-meta { font-size: 10.5px; font-weight: 550; letter-spacing: .2em; text-transform: uppercase; opacity: .75; }
  .tile-tag { font-family: var(--serif); font-style: italic; font-size: clamp(17px, 1.6vw, 22px); opacity: .9; }
  .tile-go { position: absolute; top: 16px; right: 16px; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.88); color: var(--ink); transition: transform .6s var(--ease); }
  .tile-go :global(svg) { width: 16px; height: 16px; }
  .tile:hover .tile-go { transform: translate(3px, -3px) scale(1.06); }
  .tile-sm .tile-go { width: 34px; height: 34px; top: 12px; right: 12px; }
  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 200px; }
    .tile-xl, .tile-lg { grid-column: span 2; grid-row: span 2; }
    .tile-md { grid-column: span 2; }
    .tile-sm { grid-column: span 1; }
    .tile-sm:last-child { grid-column: span 2; }
  }

  /* Category tiles */
  .cats-sec { padding-bottom: clamp(72px, 9vw, 150px); }
  .cats { grid-auto-columns: calc((100% - 18px * 5) / 5.5); }
  @media (max-width: 900px) { .cats { grid-auto-columns: 44%; } }
  .cat-tile { display: grid; gap: 12px; grid-template-columns: 1fr auto; align-items: baseline; }
  .cat-img { grid-column: 1 / -1; aspect-ratio: 3/4; border-radius: var(--radius); overflow: hidden; background: var(--stone-1); }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .cat-tile:hover img { transform: scale(1.04); }
  .cat-name { font-family: var(--serif); font-style: italic; font-size: clamp(20px, 1.8vw, 26px); line-height: 1; }
  .cat-n { font-size: 12px; color: var(--muted); }

  /* Trend report */
  .trend { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 5vw, 96px); align-items: start; padding-top: 0; }
  .trend-intro { position: sticky; top: calc(var(--header-h) + var(--catbar-h) + 32px); display: grid; gap: 22px; justify-items: start; }
  .trend-title { font-size: clamp(44px, 5.4vw, 88px); margin: 0; }
  .trend-intro p { color: var(--muted); max-width: 38ch; margin: 0; }
  .trend-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 2vw, 28px); }
  .trend-card { display: grid; gap: 14px; }
  .trend-card.offset { margin-top: clamp(40px, 7vw, 120px); }
  .trend-img { aspect-ratio: 4/5; border-radius: 18px; overflow: hidden; background: var(--stone-1); }
  .trend-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .trend-card:hover img { transform: scale(1.04); }
  .trend-meta { display: flex; justify-content: space-between; align-items: baseline; }
  .trend-meta strong { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(24px, 2.2vw, 34px); }
  .trend-meta span { font-size: 12px; color: var(--muted); }
  @media (max-width: 900px) { .trend { grid-template-columns: 1fr; } .trend-intro { position: static; } .trend-card.offset { margin-top: 0; } }

  .latest-head { flex-wrap: wrap; }
  .rail-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 28px; }

  /* Shop the look */
  .looks-rail { grid-auto-columns: calc((100% - 18px * 3) / 3.3); }
  @media (max-width: 900px) { .looks-rail { grid-auto-columns: 80%; } }
  .look-tile { position: relative; display: block; aspect-ratio: 4/5; border-radius: 18px; overflow: hidden; background: var(--stone-1); }
  .look-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .look-tile:hover img { transform: scale(1.04); }
  .look-tile span { position: absolute; left: 12px; bottom: 12px; background: rgba(250,249,247,.94); border-radius: 999px; padding: 8px 14px; font-size: 10.5px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }

  /* Spotlight (appears once priced products exist) */
  .spot { background: var(--stone-1); padding-block: clamp(72px, 9vw, 140px); overflow: hidden; outline: none; }
  .spot-grid { display: grid; grid-template-columns: 1fr 1.2fr .9fr; gap: 32px; align-items: center; }
  .spot-title { font-size: clamp(44px, 5.4vw, 88px); margin: 16px 0 0; }
  .spot-stage { position: relative; height: clamp(380px, 46vw, 600px); }
  .spot-item { position: absolute; top: 0; left: 50%; width: 70%; height: calc(100% - 60px); margin-left: -35%; transition: transform 1s var(--ease), opacity .8s var(--ease), filter .8s var(--ease); cursor: pointer; }
  .spot-art { width: 100%; height: 100%; object-fit: contain; }
  .spot-item[data-pos="active"] { transform: none; opacity: 1; filter: none; z-index: 3; cursor: default; }
  .spot-item[data-pos="prev"] { transform: translateX(-62%) scale(.62); opacity: .28; filter: blur(3px) grayscale(.4); z-index: 2; }
  .spot-item[data-pos="next"] { transform: translateX(62%) scale(.62); opacity: .28; filter: blur(3px) grayscale(.4); z-index: 2; }
  .spot-item[data-pos="far-prev"] { transform: translateX(-110%) scale(.4); opacity: 0; pointer-events: none; }
  .spot-item[data-pos="far-next"] { transform: translateX(110%) scale(.4); opacity: 0; pointer-events: none; }
  .spot-nav { position: absolute; bottom: 0; left: 0; right: 0; display: flex; justify-content: center; align-items: center; gap: 18px; z-index: 4; }
  .nav-btn { width: 46px; height: 46px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: var(--shadow-soft); }
  .nav-btn :global(svg) { width: 18px; height: 18px; }
  .spot-count { font-size: 13px; letter-spacing: .1em; min-width: 70px; text-align: center; }
  .spot-panel { padding: 28px; transition: opacity .3s var(--ease), filter .3s var(--ease), transform .3s var(--ease); }
  .spot-panel.swap { opacity: 0; filter: blur(6px); transform: translateY(8px); }
  .spot-name { font-weight: 560; letter-spacing: -.03em; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.05; margin: 8px 0 10px; }
  .spot-price { font-size: 18px; margin-bottom: 18px; }
  .lbl { font-size: 10.5px; font-weight: 550; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .spot-sw { display: flex; gap: 8px; margin-bottom: 18px; }
  .spot-panel :global(.sw) { width: 26px; height: 26px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
  .spot-panel :global(.sw[aria-pressed="true"]) { box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--ink); }
  .spot-sz { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .spot-panel :global(.sz) { min-width: 42px; height: 38px; padding-inline: 10px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--hair); background: #fff; font-size: 13px; font-weight: 550; }
  .spot-panel :global(.sz:hover) { background: var(--ink); color: #fff; }
  @media (max-width: 1080px) { .spot-grid { grid-template-columns: 1fr; } .spot-stage { height: 440px; } }

  /* Season 01 band */
