---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Your bag">
  <section class="wrap page-hero">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Bag</span></nav>
    <h1 class="display">Your bag</h1>
  </section>
  <section class="wrap bag" data-cart-page>
    <div data-cart-page-lines></div>
    <aside class="summary" data-cart-page-summary hidden>
      <h2 class="h2" style="font-size:22px">Order summary</h2>
      <div class="row"><span>Subtotal</span><span data-sum-sub></span></div>
      <div class="row"><span>Shipping</span><span data-sum-ship></span></div>
      <div class="row total"><span>Total</span><span data-sum-total></span></div>
      <p class="kl" data-currency-note hidden></p>
      <button class="btn block" type="button" disabled aria-describedby="checkout-soon"><Icon name="lock" /> Checkout <span class="soon on-dark">Coming soon</span></button>
      <p class="pending" id="checkout-soon">Online checkout is coming soon. Your bag is saved on this device until then.</p>
    </aside>
  </section>
</Base>
<style>
  .bag { display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: start; }
  .summary { position: sticky; top: calc(var(--header-h) + var(--catbar-h) + 16px); background: var(--stone-1); border-radius: 18px; padding: 24px; display: grid; gap: 14px; }
  .total { font-size: 18px; font-weight: 800; border-top: 1px solid var(--line); padding-top: 14px; }
  .kl { font-size: 13px; color: var(--muted); margin: 0; }
  .pending { font-size: 13px; background: var(--stone-2); border-left: 3px solid var(--accent); padding: 10px 12px; border-radius: 10px; margin: 0; }
  @media (max-width: 900px) { .bag { grid-template-columns: 1fr; } .summary { position: static; } }
</style>
