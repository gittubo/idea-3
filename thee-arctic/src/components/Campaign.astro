---
// Cinematic campaign: a pinned, scroll-driven sequence (title card → scenes → end card).
// Scenes use the brand's campaign photos in /public/campaign. Edit titles/lines here.
import Icon from './Icon.astro';

interface Props { id?: string }
const { id = 'campaign' } = Astro.props;

const scenes = [
  { img: '/campaign/scene-1.webp', bg: '/campaign/scene-1-bg.webp', w: 1448, h: 1086, title: 'After Hours', line: 'Satin, lace and a late-night call.', alt: 'Model in a satin slip dress and lace tights on a velvet sofa' },
  { img: '/campaign/scene-2.webp', bg: '/campaign/scene-2-bg.webp', w: 1098, h: 1432, title: 'Sweet Talk', line: 'Soft knit, ribbon bows, a room in red.', alt: 'Model in a cream bow-detail cardigan on a red set' },
  { img: '/campaign/scene-3.webp', bg: '/campaign/scene-3-bg.webp', w: 993, h: 1584, title: 'Matching Energy', line: 'THEE ARCTIC sets, worn together.', alt: 'Two models in pink THEE ARCTIC sweatsuits and white jackets' },
];
const n = scenes.length + 2; // title card + scenes + end card
const pad = (k: number) => String(k).padStart(2, '0');
---
<section class="campaign" id={id} data-campaign style={`--n:${n}`} aria-label="THEE ARCTIC Season 01 campaign">
  <div class="cam-sticky">
    <!-- Title card -->
    <div class="scene title-card on" data-label="Title">
      <div class="tc">
        <span class="tc-kicker">THEE ARCTIC presents</span>
        <h2 class="tc-title"><span class="serif">The</span> Campaign</h2>
        <span class="tc-kicker">Season 01 · {scenes.length} scenes</span>
      </div>
      <span class="tc-hint" aria-hidden="true">Scroll</span>
    </div>

    {scenes.map((s, i) => (
      <figure class={`scene shot ${i % 2 ? 'flip' : ''}`} data-label={`Scene ${pad(i + 1)}`}>
        <img class="bg" src={s.bg} alt="" aria-hidden="true" loading="lazy" />
        <div class="frame" style={`--ar:${(s.w / s.h).toFixed(4)}`}>
          <img class="fg" src={s.img} alt={s.alt} loading="lazy" decoding="async" />
        </div>
        <figcaption class="cap">
          <span class="cap-no">Scene {pad(i + 1)}</span>
          <h3 class="cap-title serif">{s.title}</h3>
          <p>{s.line}</p>
        </figcaption>
      </figure>
    ))}

    <!-- End card -->
    <div class="scene end-card" data-label="Fin">
      <div class="tc">
        <span class="tc-kicker">THEE ARCTIC · Season 01</span>
        <h2 class="tc-title">Now <span class="serif">showing.</span></h2>
        <div class="ec-ctas">
          <a class="btn light" href="/new-in">Shop the collection <span class="ico"><Icon name="arrow-ur" /></span></a>
          <a class="ec-link" href="/lookbook">View the lookbook</a>
        </div>
      </div>
    </div>

    <!-- Letterbox + HUD -->
    <div class="lb lb-top" aria-hidden="true"><span>THEE ARCTIC</span><span>Season 01 Campaign</span></div>
    <div class="lb lb-bottom" aria-hidden="true">
      <span data-cam-label>Title</span>
      <span class="hud-line"><i data-cam-bar></i></span>
      <span class="tnum" data-cam-count>{`00 / ${pad(scenes.length)}`}</span>
    </div>
  </div>
</section>

<script>
  import '../scripts/campaign';
</script>

<style>
  .campaign { --bar: clamp(36px, 7svh, 72px); position: relative; background: #0d0c0b; color: var(--on-dark); }
  .campaign.ready { height: calc(var(--n) * var(--stage) + var(--header-h) + var(--catbar-h)); }
  .cam-sticky { position: relative; }
  .campaign { --stage: calc(100svh - var(--header-h) - var(--catbar-h)); }
  /* Pin just below the sticky site header so the frame is never covered */
  .ready .cam-sticky { position: sticky; top: calc(var(--header-h) + var(--catbar-h)); height: var(--stage); overflow: hidden; }

  /* Scenes: stacked full-frame; without JS they simply follow one another */
  .scene { position: relative; min-height: 100svh; display: grid; place-items: center; overflow: hidden; margin: 0; }
  .ready .scene { position: absolute; inset: 0; min-height: 0; opacity: 0; visibility: hidden; transition: opacity 1.1s var(--ease-out), visibility 0s 1.1s; }
  .ready .scene.on { opacity: 1; visibility: visible; transition: opacity 1.1s var(--ease-out); }

  .bg { position: absolute; inset: -6%; width: 112%; height: 112%; object-fit: cover; transform: scale(calc(1.12 - .08 * var(--lp, 0))); }
  .shot::after { content: ''; position: absolute; inset: 0; background: radial-gradient(90% 80% at 50% 50%, transparent 30%, rgba(8,7,6,.75)); pointer-events: none; }

  /* The framed shot, with a slow scroll-driven push-in */
  .frame { position: relative; z-index: 1; aspect-ratio: var(--ar); height: min(calc(var(--stage) - 2 * var(--bar) - 48px), calc(56vw / var(--ar))); overflow: hidden; border-radius: 4px; box-shadow: 0 60px 120px -40px rgba(0,0,0,.85); transform: translateX(-14vw); }
  .flip .frame { transform: translateX(14vw); }
  .fg { width: 100%; height: 100%; object-fit: cover; transform: scale(calc(1.14 - .14 * var(--lp, 0))); transform-origin: 50% 40%; }

  .cap { position: absolute; z-index: 2; right: max(var(--gutter), 6vw); top: 50%; transform: translateY(-50%); width: min(30vw, 420px); display: grid; gap: 12px; }
  .flip .cap { right: auto; left: max(var(--gutter), 6vw); }
  .cap-no { font-size: 10.5px; font-weight: 550; letter-spacing: .24em; text-transform: uppercase; color: var(--on-dark-muted); }
  .cap-title { margin: 0; font-size: clamp(48px, 6.2vw, 112px); line-height: .9; color: #fff; }
  .cap p { margin: 0; color: rgba(242,239,234,.78); font-size: 15px; max-width: 30ch; }
  .ready .cap > * { opacity: 0; transform: translateY(24px); transition: opacity .9s var(--ease-out), transform 1.1s var(--ease-out); }
  .ready .on .cap > * { opacity: 1; transform: none; }
  .ready .on .cap > :nth-child(2) { transition-delay: .12s; }
  .ready .on .cap > :nth-child(3) { transition-delay: .24s; }

  /* Title and end cards */
  .title-card, .end-card { background: radial-gradient(70% 60% at 50% 45%, #2a2622, #0d0c0b 75%); text-align: center; }
  .tc { display: grid; gap: 22px; justify-items: center; padding-inline: var(--gutter); }
  .tc-kicker { font-size: 11px; font-weight: 550; letter-spacing: .3em; text-transform: uppercase; color: var(--on-dark-muted); }
  .tc-title { margin: 0; font-weight: 560; letter-spacing: -.05em; line-height: .9; font-size: clamp(64px, 11vw, 200px); color: #fff; }
  .tc-hint { position: absolute; bottom: calc(var(--bar) + 24px); font-size: 10.5px; letter-spacing: .3em; text-transform: uppercase; color: var(--on-dark-muted); animation: hint 2.4s var(--ease) infinite; }
  @keyframes hint { 0%, 100% { transform: translateY(0); opacity: .5; } 50% { transform: translateY(8px); opacity: 1; } }
  .ec-ctas { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  .ec-link { font-size: 12px; font-weight: 550; letter-spacing: .14em; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,.5); padding-bottom: 3px; }
  .ready .tc > * { opacity: 0; transform: translateY(20px); transition: opacity 1s var(--ease-out), transform 1.2s var(--ease-out); }
  .ready .on .tc > * { opacity: 1; transform: none; }
  .ready .on .tc > :nth-child(2) { transition-delay: .15s; }
  .ready .on .tc > :nth-child(3) { transition-delay: .3s; }

  /* Letterbox bars with a film HUD */
  .lb { display: none; }
  .ready .lb { display: flex; position: absolute; left: 0; right: 0; z-index: 5; height: var(--bar); background: #0d0c0b; align-items: center; justify-content: space-between; gap: 20px; padding-inline: var(--gutter); font-size: 10.5px; font-weight: 550; letter-spacing: .24em; text-transform: uppercase; color: var(--on-dark-muted); }
  .lb-top { top: 0; }
  .lb-bottom { bottom: 0; }
  .hud-line { flex: 1; max-width: 420px; height: 1px; background: rgba(255,255,255,.15); position: relative; overflow: hidden; }
  .hud-line i { position: absolute; inset: 0; background: var(--on-dark); transform-origin: left; transform: scaleX(0); }

  @media (max-width: 820px) {
    .frame, .flip .frame { transform: translateY(-48px); height: min(calc(var(--stage) - 2 * var(--bar) - 190px), calc(84vw / var(--ar))); }
    .cap, .flip .cap { left: var(--gutter); right: var(--gutter); top: auto; bottom: calc(var(--bar) + 20px); transform: none; width: auto; text-align: center; justify-items: center; gap: 6px; }
    .cap-title { font-size: clamp(40px, 12vw, 64px); }
    .cap p { font-size: 13.5px; }
    .lb-top span:last-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bg, .fg { transform: none !important; }
    .tc-hint { animation: none; }
  }
</style>
