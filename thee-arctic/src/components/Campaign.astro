---
// Cinematic campaign: plays by itself (film first, then each photo), crossfading between scenes.
// Media lives in /public/media and /public/campaign. Edit titles and lines here.
interface Props { id?: string }
const { id = 'campaign' } = Astro.props;

type Scene =
  | { kind: 'video'; wide: string; tall: string; poster: string; title: string; line: string; alt: string }
  | { kind: 'photo'; img: string; bg: string; w: number; h: number; title: string; line: string; alt: string };

const scenes: Scene[] = [
  { kind: 'video', wide: '/media/landing-16x9.mp4', tall: '/media/landing-9x16.mp4', poster: '/media/landing-16x9.jpg', title: 'In Motion', line: 'Season 01, on film.', alt: 'THEE ARCTIC Season 01 campaign film' },
  { kind: 'photo', img: '/campaign/scene-1.webp', bg: '/campaign/scene-1-bg.webp', w: 1448, h: 1086, title: 'After Hours', line: 'Satin, lace and a late-night call.', alt: 'Model in a satin slip dress and lace tights on a velvet sofa' },
  { kind: 'photo', img: '/campaign/scene-2.webp', bg: '/campaign/scene-2-bg.webp', w: 1098, h: 1432, title: 'Sweet Talk', line: 'Soft knit, ribbon bows, a room in red.', alt: 'Model in a cream bow-detail cardigan on a red set' },
  { kind: 'photo', img: '/campaign/scene-3.webp', bg: '/campaign/scene-3-bg.webp', w: 993, h: 1584, title: 'Matching Energy', line: 'THEE ARCTIC sets, worn together.', alt: 'Two models in pink THEE ARCTIC sweatsuits and white jackets' },
];
const pad = (k: number) => String(k).padStart(2, '0');
---
<section class="campaign" id={id} data-campaign aria-roledescription="carousel" aria-label="THEE ARCTIC Season 01 campaign">
  {scenes.map((s, i) => (
    <figure class={`scene ${s.kind} ${i === 0 ? 'on' : ''} ${i % 2 ? 'flip' : ''}`} aria-roledescription="slide" aria-label={`${i + 1} of ${scenes.length}`}>
      {s.kind === 'video' ? (
        <video class="film" data-wide={s.wide} data-tall={s.tall} poster={s.poster} muted playsinline preload="none" aria-label={s.alt}></video>
      ) : (
        <>
          <img class="bg" src={s.bg} alt="" aria-hidden="true" loading="lazy" />
          <div class="frame" style={`--ar:${(s.w / s.h).toFixed(4)}`}>
            <img class="fg" src={s.img} alt={s.alt} loading="lazy" decoding="async" />
          </div>
        </>
      )}
      <figcaption class="cap">
        <span class="cap-no">Scene {pad(i + 1)}</span>
        <h3 class="cap-title serif">{s.title}</h3>
        <p>{s.line}</p>
      </figcaption>
    </figure>
  ))}

  <!-- Letterbox + HUD -->
  <div class="lb lb-top" aria-hidden="true"><span>THEE ARCTIC</span><span>Season 01 Campaign</span></div>
  <div class="lb lb-bottom">
    <span class="tnum" data-cam-count aria-hidden="true">{`01 / ${pad(scenes.length)}`}</span>
    <div class="segs">
      {scenes.map((s, i) => <button type="button" class="seg" data-seg={i} aria-label={`Play scene ${i + 1}: ${s.title}`}><i></i></button>)}
    </div>
    <button type="button" class="cam-toggle" data-cam-toggle aria-pressed="false" aria-label="Pause campaign">
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
    </button>
  </div>
</section>

<script>
  import '../scripts/campaign';
</script>

<style>
  .campaign {
    --bar: clamp(36px, 6svh, 60px);
    position: relative; overflow: hidden; background: #0d0c0b; color: var(--on-dark);
    height: calc(100svh - var(--header-h) - var(--catbar-h)); min-height: 520px;
  }

  /* Scenes: stacked, crossfading */
  .scene { position: absolute; inset: 0; margin: 0; display: grid; place-items: center; overflow: hidden; opacity: 0; visibility: hidden; transition: opacity 1.2s var(--ease-out), visibility 0s 1.2s; }
  .scene.on { opacity: 1; visibility: visible; transition: opacity 1.2s var(--ease-out); }

  .film { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .video::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,7,6,.55), transparent 55%); pointer-events: none; }

  .bg { position: absolute; inset: -6%; width: 112%; height: 112%; object-fit: cover; }
  .photo::after { content: ''; position: absolute; inset: 0; background: radial-gradient(90% 80% at 50% 50%, transparent 30%, rgba(8,7,6,.75)); pointer-events: none; }

  .frame { position: relative; z-index: 1; aspect-ratio: var(--ar); height: min(calc(100% - 2 * var(--bar) - 48px), calc(56vw / var(--ar))); overflow: hidden; border-radius: 4px; box-shadow: 0 60px 120px -40px rgba(0,0,0,.85); transform: translateX(-14vw); }
  .flip .frame { transform: translateX(14vw); }
  .fg { width: 100%; height: 100%; object-fit: cover; transform-origin: 50% 40%; }

  /* Slow push-in while a photo is on screen */
  .on .fg { animation: push var(--dur, 6s) linear forwards; }
  .on .bg { animation: drift var(--dur, 6s) linear forwards; }
  .paused .on .fg, .paused .on .bg { animation-play-state: paused; }
  @keyframes push { from { transform: scale(1.14); } to { transform: scale(1); } }
  @keyframes drift { from { transform: scale(1.12); } to { transform: scale(1.04); } }

  .cap { position: absolute; z-index: 2; right: max(var(--gutter), 6vw); top: 50%; transform: translateY(-50%); width: min(30vw, 420px); display: grid; gap: 12px; }
  .flip .cap { right: auto; left: max(var(--gutter), 6vw); }
  .video .cap { right: auto; left: max(var(--gutter), 6vw); top: auto; bottom: calc(var(--bar) + 40px); transform: none; }
  .cap-no { font-size: 10.5px; font-weight: 550; letter-spacing: .24em; text-transform: uppercase; color: var(--on-dark-muted); }
  .cap-title { margin: 0; font-size: clamp(48px, 6.2vw, 112px); line-height: .9; color: #fff; }
  .cap p { margin: 0; color: rgba(242,239,234,.78); font-size: 15px; max-width: 30ch; }
  .cap > * { opacity: 0; transform: translateY(24px); transition: opacity .9s var(--ease-out), transform 1.1s var(--ease-out); }
  .on .cap > * { opacity: 1; transform: none; transition-delay: .3s; }
  .on .cap > :nth-child(2) { transition-delay: .42s; }
  .on .cap > :nth-child(3) { transition-delay: .54s; }

  /* Letterbox bars with a film HUD */
  .lb { position: absolute; left: 0; right: 0; z-index: 5; height: var(--bar); background: #0d0c0b; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-inline: var(--gutter); font-size: 10.5px; font-weight: 550; letter-spacing: .24em; text-transform: uppercase; color: var(--on-dark-muted); }
  .lb-top { top: 0; }
  .lb-bottom { bottom: 0; }
  .segs { flex: 1; max-width: 520px; display: flex; gap: 6px; }
  .seg { flex: 1; height: 20px; padding: 0; background: none; border: 0; cursor: pointer; display: flex; align-items: center; }
  .seg i { display: block; width: 100%; height: 2px; background: rgba(255,255,255,.18); position: relative; overflow: hidden; border-radius: 2px; }
  .seg i::after { content: ''; position: absolute; inset: 0; background: var(--on-dark); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .cam-toggle { width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(255,255,255,.22); background: none; color: #fff; display: grid; place-items: center; cursor: pointer; }
  .cam-toggle:hover { background: rgba(255,255,255,.1); }
  .cam-toggle svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .cam-toggle .i-play { fill: currentColor; stroke: none; }
  .cam-toggle .i-play, .cam-toggle[aria-pressed="true"] .i-pause { display: none; }
  .cam-toggle[aria-pressed="true"] .i-play { display: block; }

  @media (max-width: 820px) {
    .frame, .flip .frame { transform: translateY(-48px); height: min(calc(100% - 2 * var(--bar) - 190px), calc(84vw / var(--ar))); }
    .cap, .flip .cap, .video .cap { left: var(--gutter); right: var(--gutter); top: auto; bottom: calc(var(--bar) + 20px); transform: none; width: auto; text-align: center; justify-items: center; gap: 6px; }
    .cap-title { font-size: clamp(40px, 12vw, 64px); }
    .cap p { font-size: 13.5px; }
    .lb-top span:last-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .on .fg, .on .bg { animation: none; }
  }
</style>
