---
import type { Product } from '../data/catalog';
import { money, discount, productUrl, priceOf, canBuy } from '../data/catalog';
import Icon from './Icon.astro';
interface Props { product: Product; idx?: number; eager?: boolean }
const { product: p, idx = 0, eager = false } = Astro.props;
const url = productUrl(p);
const price = priceOf(p);
const img = p.card ?? p.images[0] ?? '';
const item = {
  slug: p.slug, name: p.name, price: price ?? null, garment: p.garment,
  color: p.colors[0]?.name ?? '', hex: p.colors[0]?.hex ?? '#cccccc', img,
};
---
<article
  class="card"
  data-idx={idx}
  data-price={price ?? ''}
  data-sale={p.salePrice ? '1' : '0'}
  data-new={p.isNew ? '1' : '0'}
  data-rating={p.rating}
  data-reviews={p.reviews}
  data-cat={p.category}
  data-sizes={p.sizes.join('|')}
  data-colors={p.colors.map((c) => c.name).join('|')}
>
  <div class="media">
    <a class="hit" href={url} aria-label={p.name}></a>
    {img && <div class="pimg main"><img src={img} alt={p.name} loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>}
    {p.images[1] && <div class="pimg alt" aria-hidden="true"><img data-src={p.images[1]} alt="" decoding="async" /></div>}
    <div class="badges">
      {p.salePrice && <span class="badge sale">-{discount(p)}%</span>}
      {p.isNew && <span class="badge new">New</span>}
      {p.bestseller && <span class="badge">Bestseller</span>}
    </div>
    <button class="wish" type="button" data-wish={JSON.stringify(item)} aria-pressed="false" aria-label={`Save ${p.name} to wishlist`}>
      <Icon name="heart" />
    </button>
    {canBuy(p) && (
      <div class="quick" data-quick={JSON.stringify(item)}>
        <p>Quick add</p>
        <div class="sizes">
          {p.sizes.map((s) => <button type="button" data-size={s}>{s === 'One Size' ? 'Add' : s}</button>)}
        </div>
      </div>
    )}
  </div>
  <div class="info">
    <a class="name" href={url}>{p.name}</a>
    <div class="price">
      {price === undefined
        ? <span class="tba">Price coming soon</span>
        : p.salePrice && p.price ? <><span class="now"><span data-usd={p.salePrice}>{money(p.salePrice)}</span></span><s><span data-usd={p.price}>{money(p.price)}</span></s></> : <span><span data-usd={price}>{money(price)}</span></span>}
    </div>
    {p.colors.length > 0 && <div class="swatches">{p.colors.map((c) => <i style={`background:${c.hex}`} title={c.name}></i>)}</div>}
  </div>
</article>
