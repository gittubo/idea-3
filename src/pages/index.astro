---
import Base from '../layouts/Base.astro';
import { room1 } from '../pieces/room-1';

// The Tubo mark: a picture frame whose edge opens into a lens.
const mark = 'M37 17.5V2.5H3v43h34V30.5A6.5 6.5 0 0 1 37 17.5Z';
---
<Base title="Tubo" description="Tubo is a wordless museum: a camera searches through each painting and lets it tell its own story.">
  <div class="stage">
    <canvas class="depth" role="img" aria-label="A gallery wall with paintings, each under its own lamp."></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <div class="lens" aria-hidden="true"></div>
    <div class="plaque"></div>

    <div class="ui">
      <a class="brand" href="./" aria-label="Tubo">
        <svg viewBox="0 0 40 48" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d={mark} /></svg>
        <span aria-hidden="true">TUBO</span>
      </a>

      <nav class="wall-nav" aria-label="Paintings on the wall">
        {room1.map((e, i) => <button type="button" data-index={i}>{e.title}</button>)}
      </nav>

      <button class="icon-btn back-btn" type="button" aria-label="Back to the wall">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
          <path d="M3 9V3h6M21 15v6h-6" /><path d="M15 9 9 15M9 15V10.5M9 15h4.5" />
        </svg>
      </button>

      <div class="progress" aria-hidden="true"><div class="fill"></div></div>

      <div class="scroll-hint" aria-hidden="true">
        <svg viewBox="0 0 22 34" fill="none" stroke="currentColor" stroke-width="1.2">
          <rect x="1" y="1" width="20" height="32" rx="10" /><line class="wheel" x1="11" y1="8" x2="11" y2="12" stroke-linecap="round" />
        </svg>
      </div>

      <button class="icon-btn lens-btn" type="button" aria-label="Look closer with a lens" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /><circle cx="10.5" cy="10.5" r="2.2" />
        </svg>
      </button>
    </div>

    <div class="cursor" aria-hidden="true"><i></i></div>
    <div class="blackout" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="loading" aria-hidden="true">
      <svg viewBox="0 0 40 48" fill="none" stroke="currentColor" stroke-width="2.4"><path d={mark} /></svg>
    </div>
    <p class="fallback">This museum needs a newer browser with 3D graphics turned on.</p>
    <noscript><p class="fallback" style="display:grid">This museum needs JavaScript turned on.</p></noscript>
  </div>
  <div class="spacer" aria-hidden="true"></div>

  <script>
    import { startMuseum } from '../scripts/museum';
    import { room1 } from '../pieces/room-1';
    startMuseum(room1).catch((e) => {
      console.error(e);
      document.documentElement.classList.add('no-webgl');
    });
  </script>
</Base>
